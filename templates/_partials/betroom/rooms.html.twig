<section class="lottery-carousel container">
	<div class="section-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px;">
		<div style="text-align: left;">
			<h2 style="margin-bottom: 8px;">Active Lotteries</h2>
			<p style="color: var(--text-muted); font-weight: 500;">Browse our latest draws and join the winners</p>
		</div>
		<div class="slider-controls" style="display: flex; gap: 12px; margin-bottom: 5px;">
			<button class="slider-btn prev" id="slide-prev" style="width: 48px; height: 48px; border-radius: 12px; border: 1px solid #E2E8F0; background: white; cursor: pointer; transition: var(--transition);">
				<i class="fas fa-chevron-left"></i>
			</button>
			<button class="slider-btn next" id="slide-next" style="width: 48px; height: 48px; border-radius: 12px; border: 1px solid #E2E8F0; background: white; cursor: pointer; transition: var(--transition);">
				<i class="fas fa-chevron-right"></i>
			</button>
		</div>
	</div>

	<div class="cards-wrapper" id="lottery-cards" style="scroll-behavior: smooth;">
		{% for betroom in betrooms %}
			<div class="lottery-card">
				<div class="card-image">
					{% if betroom.image %}
						<img src="{{ asset('uploads/betrooms/' ~ betroom.image) }}" alt="{{ betroom.numBetroom }}">
					{% else %}
						{% if loop.index == 1 %}
							<img src="https://images.unsplash.com/photo-1596838132731-3301c3fd4317?q=80&w=600&auto=format&fit=crop" alt="Golden Slot">
						{% elseif loop.index == 2 %}
							<img src="https://images.unsplash.com/photo-1639762681485-074b7f938ba0?q=80&w=1200&auto=format&fit=crop" alt="Silver Slot">
						{% elseif loop.index == 3 %}
							<img src="https://images.unsplash.com/photo-1518133910546-b6c2fb7d79e3?q=80&w=600&auto=format&fit=crop" alt="Emerald draw">
						{% else %}
							<img src="https://images.unsplash.com/photo-1634704784915-aacf363b021f?q=80&w=600&auto=format&fit=crop" alt="Lottery Draw">
						{% endif %}
					{% endif %}
				</div>
				<div class="card-info">
					<div class="ticket-status">
						<i class="fas fa-ticket-alt"></i>
						<span class="ticket-count">{{ betroom.maxTicket - betroom.buyTicket }}</span>
						<span class="label">Tickets Remaining</span>
					</div>
					<div class="countdown" data-date-end="{{ betroom.closingAt ? betroom.closingAt|date('Y/m/d H:i:s') : closedAt }}">
						<div class="timer-unit">
							<span class="val">00</span>
							<span class="unit">Days</span>
						</div>
						<div class="timer-unit">
							<span class="val">00</span>
							<span class="unit">Hrs</span>
						</div>
						<div class="timer-unit">
							<span class="val">00</span>
							<span class="unit">Mins</span>
						</div>
						<div class="timer-unit">
							<span class="val">00</span>
							<span class="unit">Secs</span>
						</div>
					</div>
					<div class="card-footer">
						<div class="price-tag">Ticket Price:
							<span class="price">{{ betroom.ticketPrice }}$</span>
						</div>
						<button class="buy-btn" onclick="window.location.href='{{ path('lottery_page', {reference: betroom.reference}) }}'">Buy Now</button>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>
</section>
