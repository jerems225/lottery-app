<style>
  .countdown {
    text-transform: uppercase;
    font-weight: bold;
    height: 30px;
    width: 200px;
  }

  .countdown span {
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
    font-size: 2rem;
  }

  .countdown span:first-of-type {
    margin-left: 0;
  }

  .countdown-circles {
    text-transform: uppercase;
    font-weight: bold;
  }

  .countdown-circles span {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0);
  }

  .countdown-circles span:first-of-type {
    margin-left: 0;
  }

  body {
    min-height: 70vh;
  }

  .bg-gradient-4 {
    background: #1b1c1c;
    background: -webkit-linear-gradient(to right, #1b1c1c, var(--primary));
    background: linear-gradient(to right, #1b1c1c, var(--primary));
  }

  .rounded {
    border-radius: 1rem !important;
  }

  .btn-demo {
    border-radius: 30rem !important;
    background: rgba(255, 255, 255, 0.3);
    color: #fff;
    text-transform: uppercase;
    font-weight: bold !important;
  }

  .btn-demo:focus,
  .btn-demo:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.5);
  }
</style>

<!-- BetRoom Start -->
<div class="container-xxl bg-light my-5 py-5" style="background: rgb(0,186,179); background: linear-gradient(266deg, rgba(0,186,179,1) 24%, rgba(51,123,214,1) 100%);">
  <div class="container py-5">
    <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
      <h1 class="display-6 mb-5">SALLES DE TIRAGES</h1>
    </div>
    {% for message in app.flashes('ticket') %}
      <div class="alert alert-success" align="center">
        <b>{{message}}</b>
      </div>
    {% endfor %}
    {% for message in app.flashes('resend-email') %}
      <div class="alert alert-success alert-dismissible text-dark text-center" role="alert">
        <strong>{{message}}</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {% endfor %}
    {% if app.user and not app.user.isIsValidated %}
      <div class="alert alert-warning alert-dismissible text-dark" role="alert">
        <strong>Votre compte est toujours inactif, veuillez procéder à la validation de votre compte en vérifiant votre boîte email.</strong>
        <a href="{{path('validate.account.resend',{pseudo: app.user.pseudo})}}" class="btn btn-sm btn-outline-primary">Re-envoyer l'email de confirmation ?</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {% endif %}

  {% for message in app.flashes('winner') %}
    <div class="alert alert-success" align="center">
      <b>{{message}}</b>
    </div>
  {% endfor %}

    <div class="row g-4 justify-content-center">
      {% for betroom in betrooms | reverse %}
        <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
          <div class="causes-item d-flex flex-column bg-white border-top border-5 border-primary rounded-top overflow-hidden h-100">
            <div class="text-center p-4 pt-0">
              <div class="d-inline-block bg-primary text-white rounded-bottom fs-5 pb-1 px-3 mb-4">
                <small>{{betroom.numBetroom}}</small>
              </div>
              {% if status == "open" and betroom.buyTicket != betroom.MaxTicket %}
                <div class="d-inline-block bg-success text-white rounded-bottom fs-5 pb-1 px-3 mb-4">
                  <small>OUVERTE</small>
                </div>
              {% elseif status == "open" and betroom.buyTicket == betroom.MaxTicket %}
                <div class="d-inline-block bg-danger text-white rounded-bottom fs-5 pb-1 px-3 mb-4">
                  <small class="text-uppercase">déjà épuisé</small>
                </div>
              {% elseif status == "closed" %}
                <div class="d-inline-block bg-danger text-white rounded-bottom fs-5 pb-1 px-3 mb-4">
                  <small class="text-uppercase">FERMée</small>
                </div>
              {% endif %}

              <h5 class="mb-3">
                <b class="text-primary" style="font-size:37px">{{betroom.TicketPrice}}$</b>
                le ticket</h5>
              <div class="causes-progress bg-light p-3 pt-2">
                <div class="d-flex justify-content-between">
                  <p class="text-dark">{{(betroom.buyTicket)|number_format(0, '', '.')}}
                    <small class="text-body">Acheté(s)</small>
                  </p>
                  <p class="text-dark">{{betroom.MaxTicket|number_format(0, '', '.')}}
                    <small class="text-body">Tickets</small>
                  </p>
                </div>
                {% if betroom.buyTicket == 0 %}
                  <div class="progress">
                    <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                      <span>0%</span>
                    </div>
                  </div>
                {% else %}
                  {% set percent = (100 * betroom.buyTicket) / betroom.MaxTicket %}
                  <div class="progress">
                    <div class="progress-bar" role="progressbar" aria-valuenow="{{percent|round(1, 'floor')}}" aria-valuemin="0" aria-valuemax="100">
                      <span class="p-2">{{percent|round(2, 'floor')}}%</span>
                    </div>
                  </div>
                {% endif %}
              </div>

              <a class="btn btn-primary mt-3">
                GAIN DE
                <strong>{{betroom.awards|number_format(0, '', '.')}}$</strong>
              </a>

              {% if status == "open" and betroom.buyTicket != betroom.MaxTicket %}
                <a class="btn btn-outline-primary mt-3" href="{{path('betrooms.tickets',{reference: betroom.reference})}}">
                  PARTICIPER
                  <div class="d-inline-flex btn-sm-square bg-primary text-white rounded-circle ms-2">
                    <i class="fa fa-arrow-right"></i>
                  </div>
                </a>
              {% elseif status == "open" and betroom.buyTicket == betroom.MaxTicket %}
                <a class="btn btn-outline-danger mt-3" href="#">
                  PLEINE
                  <div class="d-inline-flex btn-sm-square bg-danger text-white rounded-circle ms-2">
                    <i class="fa fa-lock"></i>
                  </div>
                </a>
              {% elseif status == "closed" %}
                <a class="btn btn-success mt-3" href="{% if app.user %} path('user.tickets', {pseudo: app.user.pseudo}){% else %}#{% endif %}">
                  MES TICKETS
                  <div class="d-inline-flex btn-sm-square bg-white text-success rounded-circle ms-2">
                    <i class="fa fa-arrow-right"></i>
                  </div>
                 </a>
              {% endif %}

            </div>
            <div class="position-relative mt-auto">
              <img class="img-fluid" src="{{asset('assets/img/banner-4.png')}}" alt="">
              <div class="causes-overlay">
                <a class="btn btn-outline-light">
                  Vous pouvez gagner allez-y !
                  <div class="d-inline-flex btn-sm-square bg-primary text-white rounded-circle ms-2">
                    <i class="fa fa-smile text-warning"></i>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

      <div class="py-2 back-to-top">
        <div class="row">
          <div class="col">
            <!-- Countdown 4-->
            <div class="rounded bg-gradient-4 text-white shadow p-1 text-center mb-5">
              <div id="clock-c" class="countdown text-white"></div>
              <small id="text-countdown" class="font-weight-bold"></small>
            </div>
          </div>
        </div>
    </div>
  </div>
</div>
<!-- BetRoom End -->
<script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.countdown/2.2.0/jquery.countdown.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function ($) {
    function getClosedFromNow() {
      var closedAt = new Date("{{closedAt}}");
      var currentDate = new Date();
      var countClosed = new Date(new Date().valueOf() + (closedAt - currentDate));
      return new Date(countClosed.setSeconds(countClosed.getSeconds() + 2));
    }
    function getOpenFromNow() {
      var openAt = new Date("{{openAt}}");
      var currentDate = new Date();
      var countOpen = new Date(new Date().valueOf() + (openAt - currentDate));
      return new Date(countOpen.setSeconds(countOpen.getSeconds() + 3));
    }

    var status = "{{status}}";
    if (status === "open") {
      $('#text-countdown').text("Fermeture des salles");
      $('#clock-c').countdown(getClosedFromNow(), function (event) {
        $(this).html(event.strftime('' + '<span class="h4 font-weight-bold text-danger">%M</span> Min' + '<span class="h4 font-weight-bold text-danger">%S</span> Sec'));
      }).on('finish.countdown', function (event) {
        location.reload()
      });
    }

    if (status === "closed") {
      console.log(status)
      $('#text-countdown').text("Ouverture des salles")
      $('#clock-c').countdown(getOpenFromNow(), function (event) {
        $(this).html(event.strftime('' + '<span class="h4 font-weight-bold text-white">%M</span> Min' + '<span class="h4 font-weight-bold text-white">%S</span> Sec'));
      }).on('finish.countdown', function (event) {
        location.reload();
      })
    }

  })(jQuery);
</script>
