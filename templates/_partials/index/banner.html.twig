<section class="hero">
	<div class="hero-content">
		<h1 class="hero-title">BitLOT</h1>
		<p class="hero-subtitle">The next generation of provably fair Bitcoin lotteries. Secure, transparent,
												and community-driven.</p>

		<div class="hero-actions">
			<button class="wallet-btn pulse-gold hero-cta" onclick="window.location.href='{{path('lottery_page')}}'">Start Winning Now</button>
			<button class="nav-link btn-outline" onclick="window.location.href='{{path('betrooms')}}'">Explore Rooms</button>
		</div>

		<div class="hero-main-visual">
			<img
			src="https://images.unsplash.com/photo-1639762681485-074b7f938ba0?q=80&w=1200&auto=format&fit=crop" alt="Crypto Future" class="hero-img-card">

			<!-- Floating Assets Over the Card -->
			<img src="https://cdn.jsdelivr.net/gh/atomiclabs/cryptocurrency-icons@1a61142/svg/color/btc.svg" class="floating-element coin-1" alt="BTC" style="top: -40px; left: -20px; width: 80px; z-index: 20;">
			<img src="https://cdn.jsdelivr.net/gh/atomiclabs/cryptocurrency-icons@1a61142/svg/color/bnb.svg" class="floating-element coin-2" alt="BNB" style="bottom: 40px; right: -40px; width: 100px; z-index: 20;">
			<img src="https://cdn.jsdelivr.net/gh/atomiclabs/cryptocurrency-icons@1a61142/svg/color/eth.svg" class="floating-element coin-3" alt="ETH" style="top: 40%; right: -5%; width: 60px; z-index: 20;">
			<img src="https://cdn.jsdelivr.net/gh/atomiclabs/cryptocurrency-icons@1a61142/svg/color/usdt.svg" class="floating-element coin-4" alt="USDT" style="bottom: 10%; left: 0%; width: 70px; z-index: 20;">

			<div class="hero-overlay-card" style="bottom: 20px; right: 40px;">
				<div style="width: 48px; height: 48px; background: var(--primary-gold); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px;">
					<i class="fas fa-trophy"></i>
				</div>
				<div>
					<div>
						<span style="display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Latest Jackpot</span>
						<strong class="jackpot-amount" style="font-size: 20px; font-weight: 800; color: #111827;">14.5 BTC</strong>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
