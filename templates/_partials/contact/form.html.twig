

    <!-- Contact Start -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-12 wow fadeIn" data-wow-delay="0.1s">
                    <h1 class="display-6 mb-5">Faites nous parvenir un message !</h1>
                    {% for message in app.flashes('contact') %}
                        <div class="alert alert-success" align="center">
                            <b>{{message}}</b>
                        </div>
                    {% endfor %}
                    {{form_start(form)}}
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    {{form_widget(form.fullname,{'attr':{'class':'form-control', 'placeholder':'votre nom complet'}})}}
                                    <label for="name">Votre Nom Complet</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    {{form_widget(form.email,{'attr':{'class':'form-control', 'placeholder':'votre email'}})}}
                                    <label for="email">Votre Email</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    {{form_widget(form.subject,{'attr':{'class':'form-control', 'placeholder':'le sujet du message ...'}})}}
                                    <label for="subject">Sujet</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    {{form_widget(form.message,{'attr':{'class':'form-control', 'placeholder':'Message ...'}})}}
                                    <label for="message">Message</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-dark py-2 px-3 me-3" >
                                    Envoyer le message
                                    <div class="d-inline-flex btn-sm-square bg-white text-primary rounded-circle ms-2">
                                        <i class="fa fa-arrow-right"></i>
                                    </div>
                                </button>
                            </div>
                        </div>
                    {{form_end(form)}}
                </div>
            </div>
        </div>
    </div>
    <!-- Contact End -->