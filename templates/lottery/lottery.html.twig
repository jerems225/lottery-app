{% extends 'base.html.twig' %}
{% block title %}Buy Tickets |
{% endblock title %}

{% block body %}
	<main class="container">
		<section class="checkout-section">
			<div
				class="checkout-grid">
				<!-- Left: Ticket Selection -->
				<div class="cart-panel glass-card">
					<div class="panel-header">
						<h2>
							<i class="fas fa-shopping-cart"></i>
							My Cart</h2>
						<p>Customize your entry and choose your preferred payment method.</p>
					</div>

					<div class="ticket-selector">
						<div class="qty-control">
							<input type="number" value="2" id="ticket-qty" min="1" max="20">
							<div class="qty-btns">
								<button class="plus-btn">
									<i class="fas fa-plus"></i>
								</button>
								<button class="minus-btn">
									<i class="fas fa-minus"></i>
								</button>
							</div>
						</div>
						<div class="limit-info">
							<span>Your Quota</span>
							<strong>20 Tickets</strong>
						</div>
					</div>

					<div class="cost-summary">
						<div class="cost-header">
							<i class="fas fa-coins"></i>
							Total Cost Breakdown
						</div>
						<div class="currency-card">
							<div class="curr-icon">
								<img src="https://cryptologos.cc/logos/binance-coin-bnb-logo.svg" alt="BNB">
							</div>
							<div class="curr-info">
								<strong>BINANCE (BNB)</strong>
								<span>0.07 BNB per ticket</span>
							</div>
							<div class="total-badge">
								Total:
								<span class="gold-val" id="total-price">230 $</span>
							</div>
						</div>
					</div>

					{% if app.user %}
						<button class="buy-tickets-btn">
							<i class="fas fa-ticket-alt" style="margin-right: 10px;"></i>
							Confirm & Buy Tickets
						</button>
					{% else %}
						<a href="{{path('app_login')}}" class="buy-tickets-btn" style="display:block; text-align:center; text-decoration:none;">
							<i class="fas fa-sign-in-alt" style="margin-right: 10px;"></i>
							Login to Buy Tickets
						</a>
					{% endif %}
				</div>

				<!-- Right: Lottery Info Card -->
				<div class="info-panel">
					<div class="lottery-preview-card">
						<div class="preview-img">
							{% if betroom and betroom.image %}
								<img src="{{ asset('uploads/betrooms/' ~ betroom.image) }}" alt="{{ betroom.numBetroom }}" class="img-fluid">
							{% else %}
								<img src="https://images.unsplash.com/photo-1596838132731-3301c3fd4317?q=80&w=800&auto=format&fit=crop" alt="Golden Slot" class="img-fluid">
							{% endif %}
						</div>
						<div class="preview-body">
							<div class="ticket-stat">
								<i class="fas fa-layer-group"></i>
								<span class="num">{{ betroom ? (betroom.maxTicket - betroom.buyTicket)|number_format(0, ',', '.') : '0' }}</span>
								<span class="lbl">Tickets Remaining</span>
							</div>
							<div class="preview-timer" data-date-end="{{ (betroom and betroom.closingAt) ? betroom.closingAt|date('Y/m/d H:i:s') : closedAt }}">
								<div class="timer-unit">
									<span class="val">00</span>
									<span class="unit">Days</span>
								</div>
								<div class="timer-unit">
									<span class="val">00</span>
									<span class="unit">Hrs</span>
								</div>
								<div class="timer-unit">
									<span class="val">00</span>
									<span class="unit">Mins</span>
								</div>
								<div class="timer-unit">
									<span class="val">00</span>
									<span class="unit">Secs</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<script>
		// Simple qty logic
const qInput = document.getElementById('ticket-qty');
const plusBtn = document.querySelector('.plus-btn');
const minusBtn = document.querySelector('.minus-btn');

if (plusBtn && minusBtn && qInput) {
plusBtn.onclick = () => {
if (parseInt(qInput.value) < 20) 
qInput.value = parseInt(qInput.value) + 1;


};
minusBtn.onclick = () => {
if (qInput.value > 1) 
qInput.value = parseInt(qInput.value) - 1;


};
}
	</script>
{% endblock body %}
