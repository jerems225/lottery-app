{% extends './admins/adminbase.html.twig' %}
{% block title %}Liste des demandes de rechargements
{% endblock title %}
{% block body %}
	<!-- Content wrapper -->
	<div
		class="content-wrapper">
		<!-- Content -->

		<div class="container-xxl flex-grow-1 container-p-y">

			{% for message in app.flashes('admins.valid.req') %}
				<div class="alert alert-success text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			{% for message in app.flashes('admins.reject.req') %}
				<div class="alert alert-danger text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			{% for message in app.flashes('admins.balance.error') %}
				<div class="alert alert-danger text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			{% for message in app.flashes('admins.req.booked') %}
				<div class="alert alert-success text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			<div class="col-xl-12">
				<div class="card">
					<div class="card-header border-bottom d-flex align-items-center justify-content-between">
						<h5 class="m-0 text-uppercase fw-bold">Demandes de Rechargements</h5>
						<span class="badge bg-label-primary">{{txs|length}}
							Total</span>
					</div>
					<div class="card-body pt-4">
						<div class="table-responsive text-nowrap">
							<table class="table table-hover">
								<thead>
									<tr>
										<th>TEMPS</th>
										<th>TRANS. ID</th>
										<th>DEMANDEUR</th>
										<th>PAIEMENT</th>
										<th>MONTANT</th>
										<th>STATUT</th>
										<th class="text-center">ACTIONS</th>
									</tr>
								</thead>
								<tbody class="table-border-bottom-0">
									{% for tx in txs | reverse %}
										{% if (tx.rechargeur and app.user.id == tx.rechargeur.id) or not tx.rechargeur %}
											<tr>
												<td>
													<span class="text-muted small d-block">{{tx.createdAt|format_datetime('medium', 'none', locale='fr')}}</span>
													<span class="fw-bold small">{{tx.createdAt|format_datetime('none', 'short', locale='fr')}}</span>
												</td>
												<td>
													<code class="text-dark small">{{tx.reference|slice(0, 10)}}...</code>
												</td>
												<td>
													<div class="d-flex flex-column">
														<span class="fw-bold">{{tx.user.pseudo}}</span>
														<small class="text-muted">
															<i class="bx bx-phone small"></i>
															{{tx.user.phone}}</small>
														<small class="badge bg-label-secondary p-0 mt-1" style="font-size: 0.6rem; width: fit-content;">{{tx.country}}</small>
													</div>
												</td>
												<td>
													<div class="d-flex align-items-center">
														<i class="bx bx-credit-card me-2 text-primary"></i>
														<span class="small">{{tx.paymentType}}</span>
													</div>
												</td>
												<td>
													<span class="badge bg-label-success fw-bold">{{tx.amount|number_format(2)}}
														$</span>
												</td>
												<td>
													{% if tx.status == "en attente de traitement" %}
														<span class="badge bg-label-warning">À traiter</span>
													{% elseif tx.status == "annulée" %}
														<span class="badge bg-label-danger">Annulée</span>
													{% elseif tx.status == "acceptée" %}
														<span class="badge bg-label-success">Terminée</span>
													{% elseif tx.status == "booked" %}
														<span class="badge bg-label-info">En cours (Moi)</span>
													{% endif %}
												</td>
												<td class="text-center">
													{% if tx.status == "booked" %}
														<div class="btn-group btn-group-sm">
															<a href="{{path('admins.rechargements.req.status',{id: tx.id, reference: tx.reference, status: "accepted"})}}" class="btn btn-success" title="Valider">
																<i class="bx bx-check"></i>
															</a>
															<a href="mailto:{{tx.user.email}}" class="btn btn-primary" title="Email">
																<i class="bx bx-envelope"></i>
															</a>
															<a href="{{path('admins.rechargements.req.status',{id: tx.id, reference: tx.reference, status: "en attente de traitement"})}}" class="btn btn-outline-danger" title="Relâcher">
																<i class="bx bx-undo"></i>
															</a>
														</div>
													{% elseif tx.status == "en attente de traitement" %}
														<a href="{{path('admins.rechargements.req.status',{id: tx.id, reference: tx.reference, status: "booked"})}}" class="btn btn-sm btn-primary">Prendre en charge</a>
													{% elseif tx.status == "acceptée" %}
														<i class="bx bx-check-double text-success fs-4"></i>
													{% endif %}
												</td>
											</tr>
										{% endif %}
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

		{% endfor %}

		{% if txs | length == 0 %}
			<tr class="table-dark">
				<td colspan="7">
					<p class="text-center text-muted">Aucun rechargement disponible</p>
				</td>
			</tr>
		{% endif %}
	</tbody>
</table></div></div></div></div></div></div><!-- / Content --><div class="content-backdrop fade"></div></div><!-- Content wrapper -->{% endblock body %}
