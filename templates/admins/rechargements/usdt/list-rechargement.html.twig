{% extends './admins/adminbase.html.twig' %}
{% block title %}Liste des rechargements usdt
{% endblock title %}
{% block body %}
	<!-- Content wrapper -->
	<div
		class="content-wrapper">
		<!-- Content -->

		<div class="container-xxl flex-grow-1 container-p-y">

			{% for message in app.flashes('admins.valid.usdt') %}
				<div class="alert alert-success text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			{% for message in app.flashes('admins.reject.usdt') %}
				<div class="alert alert-danger text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			<div class="col-xl-12">
				<div class="card">
					<div class="card-header border-bottom d-flex align-items-center justify-content-between">
						<h5 class="m-0 text-uppercase fw-bold">Rechargements USDT</h5>
						<span class="badge bg-label-primary">{{txs|length}}
							Total</span>
					</div>
					<div class="card-body pt-4">
						<div class="table-responsive text-nowrap">
							<table class="table table-hover">
								<thead>
									<tr>
										<th>DATE POURÉ</th>
										<th>TRANS. ID</th>
										<th>ADRESSE SOURCE</th>
										<th>MONTANT</th>
										<th>STATUT</th>
										<th class="text-center">ACTIONS</th>
									</tr>
								</thead>
								<tbody class="table-border-bottom-0">
									{% for tx in txs | reverse %}
										<tr>
											<td>
												<span class="text-muted small d-block">{{tx.createdAt|format_datetime('medium', 'none', locale='fr')}}</span>
												<span class="fw-bold small">{{tx.createdAt|format_datetime('none', 'short', locale='fr')}}</span>
											</td>
											<td>
												<code class="text-dark small">{{tx.reference|slice(0, 12)}}...</code>
											</td>
											<td>
												<small class="text-muted">{{tx.address|slice(0, 20)}}...</small>
											</td>
											<td>
												<span class="badge bg-label-success fw-bold">{{tx.amount|number_format(2)}}
													$</span>
											</td>
											<td>
												{% if tx.status == "en attente de validation" %}
													<span class="badge bg-label-warning">En attente</span>
												{% elseif tx.status == "annulée" %}
													<span class="badge bg-label-danger">Annulée</span>
												{% elseif tx.status == "acceptée" %}
													<span class="badge bg-label-success">Acceptée</span>
												{% endif %}
											</td>
											<td class="text-center">
												<div class="d-flex justify-content-center gap-2">
													{% if tx.status != "acceptée" %}
														<a href="{{path('admins.rechargements.usdt.status',{id: tx.id, reference: tx.reference, status: "accepted"})}}" class="btn btn-icon btn-sm btn-label-success" title="Valider">
															<i class="bx bx-check"></i>
														</a>
													{% endif %}
													{% if tx.status != "annulée" %}
														<a href="{{path('admins.rechargements.usdt.status',{id: tx.id, reference: tx.reference, status: "canceled"})}}" class="btn btn-icon btn-sm btn-label-danger" title="Annuler">
															<i class="bx bx-x"></i>
														</a>
													{% endif %}
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

			{% if txs | length == 0 %}
				<tr class="table-dark">
					<td colspan="7">
						<p class="text-center text-muted">Aucun rechargement disponible</p>
					</td>
				</tr>
			{% endif %}
		</tbody>
	</table>
</div></div></div></div></div></div><!-- / Content --><div class="content-backdrop fade"></div></div><!-- Content wrapper -->{% endblock body %}
