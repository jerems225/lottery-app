{% extends './admins/profil/header.html.twig' %}
{% block title %}
  {{app.user.pseudo}} - Mes Temoignages
{% endblock title %}
{% block body %}
  <!-- Content wrapper -->
  <div class="content-wrapper">
    <!-- Content -->


    <div class="container-xxl flex-grow-1 container-p-y">
        <!-- Vertically Centered Modal -->
        <div class="col-lg-4 col-md-6">
          <div class="mt-3">
            <!-- Modal -->
            <div class="modal fade" id="modalCenter" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="modalCenterTitle">NOUVEAU TEMOIGNAGE</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    {{form_start(form)}}
                      <div class="row">
                        <div class="col mb-3">
                          <label for="nameWithTitle" class="form-label">COMMENTAIRE / AVIS / TEMOIGNAGE</label>
                          {{form_widget(form.message,{'attr':{'class':'form-control', 'placeholder':'Votre temoignage ...'}})}}
                        </div>
                      </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                          Annuler
                        </button>
                        <button type="submit" class="btn btn-primary">Sauvegarder les changements</button>
                      </div>
                    {{form_end(form)}}
                </div>
              </div>
            </div>
          </div>
        </div>

        {% for message in app.flashes('testimony') %}
            <div class="alert alert-success alert-dismissible text-dark text-center" role="alert">
            <strong>{{message}}</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
        <div class="card">
            <h5 class="card-header text-uppercase">Mes Temoignages</h5>
            <div class="table-responsive text-nowrap">
              <table class="table">
                <thead>
                  <tr>
                    <th colspan="3">
                      <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCenter">Faire un temoignage
                        <i class="bx bx-plus-circle"></i>
                      </a>
                    </th>
                  </tr>
                  <tr class="bg-dark">
                    <th class="text-white">PSEUDO</th>
                    <th class="text-white">MESSAGE</th>
                    <th colspan="2" class="text-white">ACTIONS</th>
                  </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                  {% for t in testimonies|reverse %}
                    <tr class="table-white">
                      <td>
                        <strong>{{t.user.pseudo}}</strong>
                      </td>
                      <td>
                        <span class="badge bg-label-warning text-dark text-lowercase me-1">{{t.message}}</span>
                      </td>
                      <td>
                        <a href="{{path('user.profil.testimony.remove',{pseudo: app.user.pseudo, id: t.id})}}" class="btn btn-sm btn-danger text-uppercase">Supprimer</a>
                      </td>
                    </tr>
                  {% endfor %}
                  {% if testimonies | length == 0 %}
                    <tr class="">
                      <td colspan="7">
                        <p class="text-center text-muted">Aucun Temoignage enregistré</p>
                      </td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
          </div>
    </div>
    <!-- / Content -->

    <div class="content-backdrop fade"></div>
  </div>
  <!-- Content wrapper -->
{% endblock body %}