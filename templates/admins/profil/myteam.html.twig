{% extends './admins/profil/header.html.twig' %}
{% block title %}
  {{app.user.pseudo}} - Votre Equipe
{% endblock title %}
{% block body %}
  <!-- Content wrapper -->
  <div class="content-wrapper">
    <!-- Content -->


    <div class="container-xxl flex-grow-1 container-p-y">
        <div class="card">
            <h5 class="card-header">Mon Equipe - Liste des filleuls</h5>
            <a class="badge badge-sm bg-dark mb-4 text-white text-lowercase">Lien de parrainage <i class="bx bx-right-arrow-circle"></i> <b>{{referral_url}}</b></a>
            <div class="table-responsive text-nowrap">
              <table class="table">
                <thead class="table-dark text-white">
                  <tr>
                    <th class="text-white">Pseudo</th>
                    <th class="text-white">Email</th>
                    <th class="text-white">Nombre de fois gagnant</th>
                    <th class="text-white">Gain total</th>
                    <th class="text-white">Gain total Parrain</th>
                  </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                {% for f in filleuls|reverse %}
                    <tr>
                        <td>
                            <strong>{{f.pseudo}}</strong>
                        </td>
                        <td>
                            <span class="badge bg-label-primary text-dark me-1 text-lowercase">{{f.email}}</span>
                        </td>
                        <td>
                            <span class="badge bg-label-primary text-dark me-1 text-lowercase">{{f.numWin|number_format('0','.',',')}} fois gagnant</span>
                        </td>
                        <td><span class="badge bg-label-success text-dark me-1">{{f.gain_user|number_format('2','.',',')}} $USD</span></td>
                        <td><span class="badge bg-label-success text-dark  me-1">{{f.gain_referrer|number_format('2','.',',')}} $USD</span></td>
                    </tr>
                {% endfor %}
    
                {% if filleuls|length == 0 %}
                <tr>
                    <td colspan="6" class="text-center">
                        <strong>Vous n'avez aucun filleuls, Partagez votre code de parrainage pour en avoir !!!</strong>
                    </td>
                </tr>
                {% endif %}
                </tbody>
              </table>
            </div>
          </div>
    </div>
    <!-- / Content -->

    <div class="content-backdrop fade"></div>
  </div>
  <!-- Content wrapper -->
{% endblock body %}