{% extends './admins/profil/header.html.twig' %}
{% block title %}Ajouter des fonds
{% endblock title %}
{% block body %}
  <!-- Content wrapper -->
  <div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">

      <!-- Horizontal -->
      <h5 class="pb-1 mb-4 text-white">Faites un choix du type de Rechargement</h5>
      <div class="row mb-5">
        <div class="col-md">
          <div class="card mb-3">
            <div class="row g-0">
              <div class="col-md-4">
                <img class="card-img card-img-left" src="{{asset('admins/img/elements/trc20.png')}}" alt="Card image"/>
              </div>
              <div class="col-md-8">
                <div class="card-body text-end">
                  <h5 class="card-title">
                    <strong>Crypto-monnaie USDT(TRC20)</strong>
                  </h5>
                  <p class="card-text text-justify" style="font-size:13px">Il vous faudra procéder au paiement en
                    <b>USDT(TRC20)</b>
                    depuis votre application de crypto-monnaie, notre adresse usdt vous sera fournie à l'étape suivante</p>
                  <a href="{{path('user.rechargement.usdt.trc20',{pseudo: app.user.pseudo})}}" class="btn btn-dark">sélectionner
                    <i class="tf-icons bx bx-plus-circle"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md">
          <div class="card mb-3">
            <div class="row g-0">
              <div class="col-md-4">
                <img class="card-img card-img-left" src="{{asset('admins/img/elements/erc20.png')}}" alt="Card image"/>
              </div>
              <div class="col-md-8">
                <div class="card-body text-end">
                  <h5 class="card-title">
                    <strong>Crypto-monnaie USDT(ERC20)</strong>
                  </h5>
                  <p class="card-text text-justify" style="font-size:13px">Il vous faudra procéder au paiement en
                    <b>USDT(ERC20)</b>
                    depuis votre application de crypto-monnaie, notre adresse usdt vous sera fournie à l'étape suivante</p>
                  <a href="{{path('user.rechargement.usdt',{pseudo: app.user.pseudo})}}" class="btn btn-dark">sélectionner
                    <i class="tf-icons bx bx-plus-circle"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="row mb-5">
        <div class="col-md-6">
          <div class="card">
            <div class="row g-0">
              <div class="col-md-8">
                <div class="card-body text-start">
                  <h5 class="card-title">
                    <strong>Demande de rechargements</strong>
                  </h5>
                  <p class="card-text text-justify" style="font-size:12px">Vous allez émettre une demande de rechargement et un rechargeur fera le depot sur votre compte, plusieurs moyens de paiements sont possible avec ce systeme.</p>
                  <a href="{{path('user.rechargement.request',{pseudo: app.user.pseudo})}}" class="btn btn-dark">sélectionner
                    <i class="tf-icons bx bx-plus-circle"></i>
                  </a>
                </div>
              </div>
              <div class="col-md-4">
                <img class="card-img card-img-right" src="{{asset('admins//img/elements/change.jpg')}}" alt="Card image"/>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!--/ Horizontal -->

      {% for message in app.flashes('request.list') %}
        <div class="alert alert-success text-dark" align="center">
          <b>{{message}}</b>
        </div>
      {% endfor %}

      {% for message in app.flashes('request.list.reject') %}
      <div class="alert alert-danger text-dark" align="center">
        <b>{{message}}</b>
      </div>
    {% endfor %}

      <div class="col-xl-12">
        <h6 class="text-white">Listes des rechargements</h6>
        <div class="nav-align-top mb-4">
          <ul class="nav nav-pills mb-3 nav-fill" role="tablist">
            <li class="nav-item">
              <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-home" aria-controls="navs-pills-justified-home" aria-selected="true">
                <svg role="img" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" id="IconChangeColor" height="31" width="31">
                  <title>Tether</title>
                  <path d="M18.7538 10.5176c0 .6251-2.2379 1.1483-5.2381 1.2812l.0028.0007c-.0848.0064-.5233.0325-1.5012.0325-.7778 0-1.33-.0233-1.5237-.0325-3.0059-.1322-5.2495-.6555-5.2495-1.2819s2.2436-1.149 5.2495-1.2834v2.0442c.1965.0142.7594.0474 1.5372.0474.9334 0 1.4008-.0389 1.4849-.0466V9.2356c2.9994.1337 5.2381.657 5.2381 1.282zm5.19.5466L12.1248 22.389a.1803.1803 0 0 1-.2496 0L.0562 11.0635a.1781.1781 0 0 1-.0382-.2079l4.3762-9.1921a.1767.1767 0 0 1 .1626-.1026h14.8878a.1768.1768 0 0 1 .1612.1032l4.3762 9.1922a.1782.1782 0 0 1-.0382.2079zm-4.478-.4038c0-.8068-2.5515-1.4799-5.9473-1.6369V7.195h4.186V4.4055H6.3076V7.195h4.1852v1.8286c-3.4018.1562-5.9601.83-5.9601 1.6376 0 .8075 2.5583 1.4806 5.9601 1.6376v5.8618h3.025v-5.8639c3.394-.1563 5.948-.8295 5.948-1.6363z" id="mainIconPathAttribute" fill="#ffffff"></path>
                </svg>
                Mes Rechargements USDT
                <span class="badge rounded-pill badge-center h-px-20 w-px-20 bg-danger">{{app.user.txsUsdt|length}}</span>
              </button>
            </li>
            <li class="nav-item">
              <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-profile" aria-controls="navs-pills-justified-profile" aria-selected="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="33" height="33" fill="currentColor" class="bi bi-currency-exchange" viewbox="0 0 16 16" id="IconChangeColor">
                  <path d="M0 5a5.002 5.002 0 0 0 4.027 4.905 6.46 6.46 0 0 1 .544-2.073C3.695 7.536 3.132 6.864 3 5.91h-.5v-.426h.466V5.05c0-.046 0-.093.004-.135H2.5v-.427h.511C3.236 3.24 4.213 2.5 5.681 2.5c.316 0 .59.031.819.085v.733a3.46 3.46 0 0 0-.815-.082c-.919 0-1.538.466-1.734 1.252h1.917v.427h-1.98c-.003.046-.003.097-.003.147v.422h1.983v.427H3.93c.118.602.468 1.03 1.005 1.229a6.5 6.5 0 0 1 4.97-3.113A5.002 5.002 0 0 0 0 5zm16 5.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0zm-7.75 1.322c.069.835.746 1.485 1.964 1.562V14h.54v-.62c1.259-.086 1.996-.74 1.996-1.69 0-.865-.563-1.31-1.57-1.54l-.426-.1V8.374c.54.06.884.347.966.745h.948c-.07-.804-.779-1.433-1.914-1.502V7h-.54v.629c-1.076.103-1.808.732-1.808 1.622 0 .787.544 1.288 1.45 1.493l.358.085v1.78c-.554-.08-.92-.376-1.003-.787H8.25zm1.96-1.895c-.532-.12-.82-.364-.82-.732 0-.41.311-.719.824-.809v1.54h-.005zm.622 1.044c.645.145.943.38.943.796 0 .474-.37.8-1.02.86v-1.674l.077.018z" id="mainIconPathAttribute" fill="#ffffff"></path>
                </svg>
                Mes Demandes de Rechargements
                <span class="badge rounded-pill badge-center h-px-20 w-px-20 bg-danger">{{app.user.txReqs|length}}</span>
              </button>
            </li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane fade show active" id="navs-pills-justified-home" role="tabpanel">
              <div class="table-responsive text-nowrap">
                <table class="table">
                  <thead>
                    <tr class="bg-dark">
                      <th class="text-white">DATE</th>
                      <th class="text-white">TRANSACTION ID</th>
                      <th class="text-white">JETON</th>
                      <th class="text-white">VOTRE ADDRESSE USDT</th>
                      <th class="text-white">MONTANT</th>
                      <th class="text-white">TRANSACTION STATUS</th>
                    </tr>
                  </thead>
                  <tbody class="table-border-bottom-0">
                    {% for tx in app.user.txsUsdt | reverse %}
                      <tr class="table-white">
                        <td>
                          <strong>{{tx.createdAt|format_datetime('medium', 'medium', locale='fr')}}</strong>
                        </td>
                        <td>{{tx.reference}}</td>
                        <td><strong>{{tx.token}}</strong></td>
                        <td>{{tx.address}}</td>
                        <td>
                          <strong>{{tx.amount|number_format('2','.',',')}}
                            USD</strong>
                        </td>
                        <td>
                          {% if tx.status == "en attente de validation" %}
                            <a href="#" class="btn btn-sm btn-outline-danger">{{tx.status|upper}}</a>
                          {% elseif tx.status == "annulée" %}
                            <a href="#" class="btn btn-sm btn-danger">{{tx.status|upper}}</a>
                          {% elseif tx.status == "acceptée" %}
                            <a href="#" class="btn btn-sm btn-success">{{tx.status|upper}}</a>
                          {% endif %}
                        </td>
                      </tr>
                    {% endfor %}

                    {% if app.user.txsUsdt | length == 0 %}
                      <tr class="table-dark">
                        <td colspan="7">
                          <p class="text-center text-muted">Aucun rechargement disponible</p>
                        </td>
                      </tr>
                    {% endif %}
                  </tbody>
                </table>
              </div>
            </div>
            <div class="tab-pane fade" id="navs-pills-justified-profile" role="tabpanel">
              <div class="table-responsive text-nowrap">
                <table class="table">
                  <thead>
                    <tr class="bg-dark">
                      <th class="text-white">DATE</th>
                      <th class="text-white">DEMANDE ID</th>
                      <th class="text-white">PAIEMENT TYPE</th>
                      <th class="text-white">MONTANT</th>
                      <th class="text-white">PAYS D'EMISSION</th>
                      <th class="text-white">DEMANDE STATUS</th>
                    </tr>
                  </thead>
                  <tbody class="table-border-bottom-0">
                    {% for tx in app.user.txReqs | reverse %}
                      <tr class="table-white">
                        <td>
                          <strong>{{tx.createdAt|format_datetime('medium', 'medium', locale='fr')}}</strong>
                        </td>
                        <td>{{tx.reference}}</td>
                        <td>{{tx.paymentType}}</td>
                        <td>
                          <strong>{{tx.amount|number_format('2','.',',')}}
                            USD</strong>
                        </td>
                        <td>{{tx.country}}</td>
                        <td>
                          {% if tx.status == "en attente de traitement" %}
                            <a href="#" class="btn btn-sm btn-outline-danger">{{tx.status|upper}}</a>
                          {% elseif tx.status == "annulée" %}
                            <a href="#" class="btn btn-sm btn-danger">{{tx.status|upper}}</a>
                          {% elseif tx.status == "acceptée" %}
                            <a href="#" class="btn btn-sm btn-success">{{tx.status|upper}}</a>
                          {% endif %}
                        </td>
                      </tr>
                    {% endfor %}

                    {% if app.user.txReqs | length == 0 %}
                      <tr class="table-dark">
                        <td colspan="7">
                          <p class="text-center text-muted">Aucun rechargement disponible</p>
                        </td>
                      </tr>
                    {% endif %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- / Content -->

    <div class="content-backdrop fade"></div>
  </div>
  <!-- Content wrapper -->
{% endblock body %}
