{% extends './admins/profil/header.html.twig' %}
{% block title %}Proceder au paiement {% endblock title %}
{% block body %}
<!-- Content wrapper -->
<div class="content-wrapper">
  <!-- Content -->

  <div class="container-xxl flex-grow-1 container-p-y">

    <!-- Horizontal -->
    <h5 class="pb-1 mb-4">
        {% for message in app.flashes('usdt.check') %}
        <div class="alert alert-success text-dark" align="center">
          <b>{{message}}</b>
        </div>
      {% endfor %}
    </h5>
    
    <div class="row mb-5 d-flex justify-content-center">
        <div class="col-md-6 col-lg-7 mt-5">
          <div class="card text-center">
            <div class="card-header">Vous devez envoyer les <b>USDT(TRC20)</b> à l'adresse suivante</div>
            <div class="card-body">
              <h5 class="card-title"><b>{{COMPANY_USDT_TRC20_ADDRESS}}</b></h5>
              {% if TX.status == "en attente de validation" %}
                <p class="card-text">Faite parvenir <i class="bx bx-right-arrow-circle"></i> {{TX.amount}} USDT TRC20</p>
                <div class="spinner-grow text-dark" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <div class="spinner-grow text-dark" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <div class="spinner-grow text-dark" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              {% elseif TX.status == "acceptée" %}
              <p class="card-text">Addresse <i class="bx bx-right-arrow-circle"></i> {{TX.address}}</p>
              <p class="card-text">Vous avez fait parvenir <i class="bx bx-right-arrow-circle"></i> {{TX.amount}} USDT TRC20</p>
              <div class="alert alert-success alert-dismissible text-dark" role="alert">
                <span class="badge bg-label-success text-dark me-1">Transaction validée</span>
              </div>
              {% endif %}
            </div>
            {% if TX.status == "en attente de validation" %}
              <div class="card-footer text-muted">NB: Votre compte sera rechargé après vérification de votre paiement</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <!--/ Horizontal -->
  </div>
  <!-- / Content -->

  <div class="content-backdrop fade"></div>
</div>
<!-- Content wrapper -->
<script>
  setInterval(() => {
    var status = "{{TX.status}}";
    status=="en attente de validation"?window.location.reload(): null;
  }, 10000)
</script>
{% endblock body %}