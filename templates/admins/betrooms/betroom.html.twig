{% extends './admins/adminbase.html.twig' %}
{% block title %} Gestion des salles de tirage{% endblock %}
{% block body %}
  <!-- Content -->
  <div class="container-xxl flex-grow-1 container-p-y">

    <!-- Vertically Centered Modal -->
    <div class="col-lg-4 col-md-6">
      <div class="mt-3">
        <!-- Modal -->
        <div class="modal fade" id="modalCenter" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="modalCenterTitle">ENREGISTRER UNE NOUVELLE SALLE</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                {{form_start(form)}}
                  <div class="row">
                    <div class="col mb-3">
                      <label for="nameWithTitle" class="form-label">NOM DE LA SALLE</label>
                      {{form_widget(form.num_betroom,{'attr':{'class':'form-control', 'placeholder':'le nom de la salle de tirage ...'}})}}
                    </div>
                  </div>
                  <div class="row">
                    <div class="col mb-3">
                      <label for="nameWithTitle" class="form-label">GAIN</label>
                      {{form_widget(form.awards,{'attr':{'class':'form-control', 'placeholder':'le gain de cette salle...'}})}}
                      <small>
                        {% if not form.vars.valid %}
                          {# Loop through every form item #}
                          {% for child in form.children %}
                            {# Display the errors of the form item #}
                            {% if child.vars.name =="awards" %}
                              {%for error in child.vars.errors%}
                              <p style="color:red;">{{error.message}}</p>
                              {%endfor%}
                            {% endif %}
                          {% endfor %}
                        {% endif %}
                      </small>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col mb-3">
                      <label for="nameWithTitle" class="form-label">PRIX DU TICKET</label>
                      {{form_widget(form.ticket_price,{'attr':{'class':'form-control', 'placeholder':'le prix unitaire du ticket ...'}})}}
                      <small>
                        {% if not form.vars.valid %}
                          {# Loop through every form item #}
                          {% for child in form.children %}
                            {# Display the errors of the form item #}
                            {% if child.vars.name =="ticket_price" %}
                              {%for error in child.vars.errors%}
                              <p style="color:red;">{{error.message}}</p>
                              {%endfor%}
                            {% endif %}
                          {% endfor %}
                        {% endif %}
                      </small>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col mb-3">
                      <label for="nameWithTitle" class="form-label">TICKET MAXIMUM</label>
                      {{form_widget(form.max_ticket,{'attr':{'class':'form-control', 'placeholder':'le maximum de ticket possible ...'}})}}
                    </div>
                  </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                      Annuler
                    </button>
                    <button type="submit" class="btn btn-primary">Sauvegarder les changements</button>
                  </div>
                {{form_end(form)}}
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Liste des piece -->
    {% for message in app.flashes('admins.betrooms') %}
      <div class="alert alert-success text-dark" align="center">
        <b>{{message}}</b>
      </div>
    {% endfor %}

    {% for message in app.flashes('remove.tickets.error') %}
    <div class="alert alert-danger text-dark" align="center">
      <b>{{message}}</b>
    </div>
  {% endfor %}
    <div class="card">
      <h5 class="card-header text-uppercase">Liste des salles de tirage</h5>
      <div class="table-responsive text-nowrap">
        <table class="table">
          <thead>
            <tr>
              <th colspan="3">
                <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCenter">Enregistrer une nouvelle salle
                  <i class="bx bx-plus-circle"></i>
                </a>
              </th>
            </tr>
            <tr class="bg-dark">
              <th class="text-white">DATE</th>
              <th class="text-white">REFERENCE</th>
              <th class="text-white">SALLE</th>
              <th class="text-white">PRIX TICKET</th>
              <th class="text-white">TICKET MAXIMUM</th>
              <th class="text-white">GAIN</th>
              <th class="text-white">ACHAT TICKET</th>
              <th class="text-white">STATUS</th>
              <th colspan="2" class="text-white">ACTIONS</th>
            </tr>
          </thead>
          <tbody class="table-border-bottom-0">
            {% for b in betrooms|reverse %}
              <tr class="table-white">
                <td>
                  <strong>{{b.createdAt|format_datetime('medium', 'none', locale='fr')}}</strong>
                </td>
                <td>
                  <strong>{{b.reference}}</strong>
                </td>
                <td>
                  <strong>{{b.numBetroom}}</strong>
                </td>
                <td>
                  <span class="badge bg-label-primary text-dark me-1">{{b.TicketPrice|number_format('2','.',',')}} $USD</span>
                </td>
                <td>
                  <strong><span class="badge bg-label-warning text-dark me-1">{{b.maxTicket|number_format('0',',','.')}} Tickets Max</span></strong>
                </td>
                <td>
                  <span class="badge bg-label-primary text-dark me-1">{{b.awards|number_format('2','.',',')}} $USD</span>
                </td>
                <td>
                  <span class="badge bg-label-primary text-dark me-1">{{b.buyTicket|number_format('0',',','.')}}/{{b.maxTicket}}</span>
                </td>
                <td>
                  {% if roomSettings.status == "closed" %}
                    <span class="badge bg-label-danger text-dark me-1">Fermee</span>
                  {% elseif roomSettings.status == "open" %}
                    <span class="badge bg-label-success text-dark me-1">Ouverte</span>
                  {% elseif b.buyTicket == b.maxTicket %}
                    <span class="badge bg-label-warning text-dark me-1">Pleine</span>
                  {% endif %}
                </td>
                <td>
                  <a href="{{path('admins.betrooms.edit',{reference: b.reference})}}" class="btn btn-sm btn-dark text-uppercase">Modifier</a>
                  <a href="{{path('admins.betrooms.remove',{reference: b.reference})}}" class="btn btn-sm btn-danger text-uppercase">Supprimer</a>
                </td>
              </tr>
            {% endfor %}
            {% if betrooms | length == 0 %}
              <tr class="">
                <td colspan="7">
                  <p class="text-center text-muted">Aucune salle de tirages enregistrée</p>
                </td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
    <!--/ liste des gestionnaires -->

  </div>
  <!-- / Content -->
{% endblock %}
