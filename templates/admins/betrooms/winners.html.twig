{% extends './admins/adminbase.html.twig' %}
{% block title %}
	Liste des resultats
{% endblock %}
{% block body %}
	<!-- Content -->
	<div class="container-xxl flex-grow-1 container-p-y">

		<div class="card">
			<div class="card-header border-bottom">
				<div class="d-flex align-items-center justify-content-between">
					<h5 class="m-0 text-uppercase fw-bold">Résultats des tirages</h5>
					{{form_start(form, {'attr': {'class': 'd-flex align-items-center gap-2'}})}}
					<label class="form-label small fw-bold text-muted text-nowrap mb-0">FILTRER PAR DATE :</label>
					{{form_widget(form.result_date, {'attr': {'class': 'form-control form-control-sm', 'onchange': 'this.form.submit()'}})}}
					{{form_end(form)}}
				</div>
			</div>
			<div class="table-responsive text-nowrap">
				<table class="table table-hover">
					<thead>
						<tr>
							<th>TEMPS</th>
							<th>SALLE</th>
							<th>JOUEUR</th>
							<th>TICKET</th>
							<th>PRIX</th>
							<th>LOT</th>
							<th class="text-center">STATUT</th>
						</tr>
					</thead>
					<tbody class="table-border-bottom-0">
						{% for t in tickets|reverse %}
							<tr>
								<td>
									<span class="text-muted small d-block">{{t.updatedAt|format_datetime('medium', 'none', locale='fr')}}</span>
									<span class="fw-bold" style="font-size: 0.75rem;">
										<i class="bx bx-time"></i>
										{{t.updatedAt|format_datetime('none', 'short', locale='fr')}}</span>
								</td>
								<td>
									<span class="fw-bold">{{t.betroom.numBetroom}}</span>
								</td>
								<td>
									<div class="d-flex align-items-center">
										{% if not t.user %}
											<div class="avatar avatar-sm me-2"><img src="{{asset('admins/img/avatars/avatar.jpg')}}" class="rounded-circle"/></div>
											<span class="small text-muted">AUNCUN</span>
										{% else %}
											<div class="avatar avatar-sm me-2">
												<img src="{{ t.user.avatar ? asset('avatars/'~t.user.avatar) : asset('admins/img/avatars/avatar.jpg') }}" class="rounded-circle"/>
											</div>
											<span class="fw-bold small">{{t.user.pseudo}}</span>
										{% endif %}
									</div>
								</td>
								<td>
									<code class="badge bg-label-warning text-dark">{{t.numTicket}}</code>
								</td>
								<td>
									<span class="text-primary fw-bold small">{{t.price|number_format(2)}}
										$</span>
								</td>
								<td>
									<span class="text-success fw-bold">{{t.betroom.awards|number_format(2)}}
										$</span>
								</td>
								<td class="text-center">
									{% if t.status == "winner" and t.user %}
										<span class="badge bg-label-success">
											<i class="bx bx-star me-1"></i>
											Gagnant</span>
									{% elseif t.status == "winner" and not t.user %}
										<span class="badge bg-label-warning">Inutilisé</span>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
						{% if tickets | length == 0 %}
							<tr class="">
								<td colspan="8">
									<p class="text-center text-muted">Aucune participation ce jour !!</p>
								</td>
							</tr>
						{% endif %}
					</tbody>
				</table>
			</div>
		</div>
		<!--/ liste des gestionnaires -->

	</div>
	<!-- / Content -->

	<script src="{{asset('admins/js/admins/validateDateForm.js')}}"></script>
{% endblock %}
