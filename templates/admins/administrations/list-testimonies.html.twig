{% extends './admins/adminbase.html.twig' %}
{% block title %}
  {{app.user.pseudo}} - Mes Temoignages
{% endblock title %}
{% block body %}
  <!-- Content wrapper -->
  <div class="content-wrapper">
    <!-- Content -->


    <div class="container-xxl flex-grow-1 container-p-y">

        {% for message in app.flashes('testimony') %}
            <div class="alert alert-success alert-dismissible text-dark text-center" role="alert">
            <strong>{{message}}</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="card">
            <h5 class="card-header text-uppercase">Mes Temoignages</h5>
            <div class="table-responsive text-nowrap">
              <table class="table">
                <thead>
                  <tr>
                    <th colspan="3">
                      <a href="#" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCenter">Faire un temoignage
                        <i class="bx bx-plus-circle"></i>
                      </a>
                    </th>
                  </tr>
                  <tr class="bg-dark">
                    <th class="text-white">PSEUDO</th>
                    <th class="text-white">MESSAGE</th>
                    <th colspan="2" class="text-white">ACTIONS</th>
                  </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                  {% for t in testimonies|reverse %}
                    <tr class="table-white">
                      <td>
                        <strong>{{t.user.pseudo}}</strong>
                      </td>
                      <td>
                        <span class="badge bg-label-warning text-dark text-lowercase me-1">{{t.message}}</span>
                      </td>
                      <td>
                        {% if t.status %}
                            <a href="{{path('admins.testimony.edit',{id: t.id, status: "false"})}}" class="btn btn-sm btn-outline-danger text-uppercase">Annuler</a>
                        {% else %}
                            <a href="{{path('admins.testimony.edit',{id: t.id, status: "true"})}}" class="btn btn-sm btn-outline-success text-uppercase">Valider</a>
                            <a href="{{path('admins.testimony.edit',{id: t.id, status: "false"})}}" class="btn btn-sm btn-outline-danger text-uppercase">Annuler</a>
                        {% endif %}

                      </td>
                    </tr>
                  {% endfor %}
                  {% if testimonies | length == 0 %}
                    <tr class="">
                      <td colspan="7">
                        <p class="text-center text-muted">Aucun Temoignage enregistré</p>
                      </td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
          </div>
    </div>
    <!-- / Content -->

    <div class="content-backdrop fade"></div>
  </div>
  <!-- Content wrapper -->
{% endblock body %}