{% extends './admins/adminbase.html.twig' %}
{% block body %}
	<!-- Content -->

	<div class="container-xxl flex-grow-1 container-p-y">
		<div
			class="row">
			<!-- Main Stats Overview -->
			<div class="col-12 mb-4">
				<div class="card bg-primary text-white" style="background: linear-gradient(135deg, var(--primary-gold), var(--dark-gold)) !important;">
					<div class="card-body d-flex align-items-center justify-content-between p-4">
						<div>
							<h4 class="text-white mb-1">Tableau de bord Global</h4>
							<p class="mb-0 opacity-75">Statistiques générales de la plateforme BitLot</p>
						</div>
						<div class="bg-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: rgba(255,255,255,0.2) !important;">
							<i class="bx bx-bar-chart-alt-2 fs-3 text-white"></i>
						</div>
					</div>
				</div>
			</div>

			<!-- Detail Cards -->
			{% set stats = [
            {'label': 'Salles de tirage', 'value': overviews.betrooms, 'icon': 'bx-cube', 'color': 'primary'},
            {'label': 'Tickets Achetés', 'value': overviews.tickets_buy, 'icon': 'bx-ticket', 'color': 'info'},
            {'label': 'Gagnants Total', 'value': overviews.winners, 'icon': 'bx-trophy', 'color': 'success'},
            {'label': 'Joueurs Actifs', 'value': overviews.users_players, 'icon': 'bx-group', 'color': 'primary'},
            {'label': 'Non Participants', 'value': overviews.users_no_players, 'icon': 'bx-user-x', 'color': 'warning'},
            {'label': 'CA Total ($)', 'value': overviews.business, 'icon': 'bx-dollar-circle', 'color': 'success', 'is_money': true},
            {'label': 'Rechargements USDT Valides', 'value': overviews.txusdt_accepted, 'icon': 'bx-check-double', 'color': 'success'},
            {'label': 'USDT en Attente', 'value': overviews.txusdt_canceled, 'icon': 'bx-time-five', 'color': 'danger'}
        ] %}

			{% for stat in stats %}
				<div class="col-lg-3 col-md-6 mb-4">
					<div class="card h-100">
						<div class="card-body">
							<div class="d-flex align-items-center mb-3">
								<div class="avatar flex-shrink-0 me-3">
									<span class="avatar-initial rounded bg-label-{{ stat.color }} p-2" style="background-color: rgba(198, 163, 85, 0.1) !important;">
										<i class="bx {{ stat.icon }} fs-3" style="color: var(--primary-gold) !important;"></i>
									</span>
								</div>
								<h5 class="card-title mb-0" style="font-size: 0.9rem;">{{ stat.label }}</h5>
							</div>
							<div class="d-flex align-items-baseline">
								<h3 class="mb-0 me-2" style="font-weight: 800;">
									{% if stat.is_money|default(false) %}
										{{ stat.value|number_format(0, '.', ',') }}
										$
									{% else %}
										{{ stat.value|number_format(0, ',', '.') }}
									{% endif %}
								</h3>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}

			<!-- Financial Summary -->
			<div class="col-lg-6 mb-4">
				<div class="card h-100">
					<div class="card-header d-flex align-items-center justify-content-between pb-0">
						<div class="card-title mb-0">
							<h5 class="m-0 me-2">Résumé Financier</h5>
						</div>
					</div>
					<div class="card-body pt-4">
						<ul class="p-0 m-0">
							<li class="d-flex mb-4 pb-1">
								<div class="avatar flex-shrink-0 me-3">
									<span class="avatar-initial rounded bg-label-primary p-2">
										<i class="bx bx-trending-up"></i>
									</span>
								</div>
								<div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
									<div class="me-2">
										<h6 class="mb-0">Chiffre d'Affaires</h6>
										<small class="text-muted">Total des ventes</small>
									</div>
									<div class="user-progress">
										<small class="fw-semibold">{{overviews.business|number_format(0,'',',')}}
											$</small>
									</div>
								</div>
							</li>
							<li class="d-flex mb-4 pb-1">
								<div class="avatar flex-shrink-0 me-3">
									<span class="avatar-initial rounded bg-label-success p-2">
										<i class="bx bx-gift"></i>
									</span>
								</div>
								<div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
									<div class="me-2">
										<h6 class="mb-0">Gains Versés</h6>
										<small class="text-muted">Reversement gagnants</small>
									</div>
									<div class="user-progress">
										<small class="fw-semibold">{{overviews.awards|number_format(0,'',',')}}
											$</small>
									</div>
								</div>
							</li>
							<li class="d-flex">
								<div class="avatar flex-shrink-0 me-3">
									<span class="avatar-initial rounded bg-label-info p-2">
										<i class="bx bx-wallet"></i>
									</span>
								</div>
								<div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
									<div class="me-2">
										<h6 class="mb-0">Bénéfice Net</h6>
										<small class="text-muted">Gain plateforme</small>
									</div>
									<div class="user-progress">
										<small class="fw-bold text-success" style="font-size: 1.1rem;">{{overviews.gain|number_format(0,'',',')}}
											$</small>
									</div>
								</div>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- Pending Requests Overview -->
			<div class="col-lg-6 mb-4">
				<div class="card h-100">
					<div class="card-header pb-0">
						<h5 class="card-title mb-0">Demandes en Attente</h5>
					</div>
					<div class="card-body pt-4">
						<div class="d-flex justify-content-around align-items-center">
							<div class="text-center">
								<div class="avatar avatar-lg mx-auto mb-2">
									<span class="avatar-initial rounded-circle bg-label-danger p-3">
										<i class="bx bx-error fs-2"></i>
									</span>
								</div>
								<h4 class="mb-0">{{overviews.txreq_canceled|number_format(0,',','.')}}</h4>
								<small class="text-muted">Rechargements</small>
							</div>
							<div class="divider divider-vertical">
								<i class="bx bx-transfer-alt"></i>
							</div>
							<div class="text-center">
								<div class="avatar avatar-lg mx-auto mb-2">
									<span class="avatar-initial rounded-circle bg-label-warning p-3">
										<i class="bx bx-exit fs-2"></i>
									</span>
								</div>
								<h4 class="mb-0">{{overviews.txusdt_canceled}}</h4>
								<small class="text-muted">Transactions USDT</small>
							</div>
						</div>
						<div class="mt-4 text-center">
							<a href="{{path('admins.rechargements.req')}}" class="btn btn-primary btn-sm w-100">Gérer les demandes</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


</div>
<!-- / Content -->{% endblock %}
