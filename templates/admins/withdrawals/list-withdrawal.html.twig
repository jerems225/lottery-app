{% extends './admins/adminbase.html.twig' %}
{% block title %}Demandes de retraits
{% endblock title %}
{% block body %}
  <!-- Content wrapper -->
  <div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">

        
      {% for message in app.flashes('withdrawals') %}
        <div class="alert alert-success text-dark" align="center">
          <b>{{message}}</b>
        </div>
      {% endfor %}

      {% for message in app.flashes('admins.reject.withdrawal') %}
      <div class="alert alert-danger text-dark" align="center">
        <b>{{message}}</b>
      </div>
    {% endfor %}

    {% for message in app.flashes('admins.valid.withdrawal') %}
    <div class="alert alert-success text-dark" align="center">
      <b>{{message}}</b>
    </div>
  {% endfor %}

      {% for message in app.flashes('withdrawals.values.error') %}
      <div class="alert alert-danger text-dark" align="center">
        <b>{{message}}</b>
      </div>
    {% endfor %}

        <div class="col-xl-12">
          <h6 class="text-white">Listes des demandes de retrait</h6>
          <div class="nav-align-top mb-4">
            <ul class="nav nav-pills mb-3 nav-fill" role="tablist">
              <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-pills-justified-home" aria-controls="navs-pills-justified-home" aria-selected="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="33" height="33" fill="currentColor" class="bi bi-currency-exchange" viewbox="0 0 16 16" id="IconChangeColor">
                    <path d="M0 5a5.002 5.002 0 0 0 4.027 4.905 6.46 6.46 0 0 1 .544-2.073C3.695 7.536 3.132 6.864 3 5.91h-.5v-.426h.466V5.05c0-.046 0-.093.004-.135H2.5v-.427h.511C3.236 3.24 4.213 2.5 5.681 2.5c.316 0 .59.031.819.085v.733a3.46 3.46 0 0 0-.815-.082c-.919 0-1.538.466-1.734 1.252h1.917v.427h-1.98c-.003.046-.003.097-.003.147v.422h1.983v.427H3.93c.118.602.468 1.03 1.005 1.229a6.5 6.5 0 0 1 4.97-3.113A5.002 5.002 0 0 0 0 5zm16 5.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0zm-7.75 1.322c.069.835.746 1.485 1.964 1.562V14h.54v-.62c1.259-.086 1.996-.74 1.996-1.69 0-.865-.563-1.31-1.57-1.54l-.426-.1V8.374c.54.06.884.347.966.745h.948c-.07-.804-.779-1.433-1.914-1.502V7h-.54v.629c-1.076.103-1.808.732-1.808 1.622 0 .787.544 1.288 1.45 1.493l.358.085v1.78c-.554-.08-.92-.376-1.003-.787H8.25zm1.96-1.895c-.532-.12-.82-.364-.82-.732 0-.41.311-.719.824-.809v1.54h-.005zm.622 1.044c.645.145.943.38.943.796 0 .474-.37.8-1.02.86v-1.674l.077.018z" id="mainIconPathAttribute" fill="#ffffff"></path>
                  </svg>
                  Demandes de Retraits
                  <span class="badge rounded-pill badge-center h-px-20 w-px-20 bg-danger">{{app.user.withdrawals|length}}</span>
                </button>
              </li>
            </ul>
            <div class="tab-content">
              <div class="tab-pane fade show active" id="navs-pills-justified-home" role="tabpanel">
                <div class="table-responsive text-nowrap">
                  <table class="table">
                    <thead>
                      <tr class="bg-dark">
                        <th class="text-white">DATE</th>
                        <th class="text-white">TRANSACTION ID</th>
                        <th class="text-white">MONTANT</th>
                        <th class="text-white" colspan="2">INFORMATIONS DE PAIEMENT DU CLIENT</th>
                        <th class="text-white">TRANSACTION STATUS</th>
                        <th class="text-white" colspan="2">ACTIONS</th>
                      </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                      {% for tx in txs | reverse %}
                        <tr class="table-white">
                          <td>
                            <strong>{{tx.createdAt|format_datetime('medium', 'medium', locale='fr')}}</strong>
                          </td>
                          <td><strong>{{tx.reference}}</strong></td>
                          <td>
                            <span class="badge bg-label-primary text-dark me-1">
                                <strong>{{tx.amount|number_format('2','.',',')}}
                                    $USD
                                </strong>
                            </span>
                          </td>
                          <td>
                            <span class="badge bg-label-primary text-dark me-1">{{tx.paymentType}}</span>
                          </td>
                          <td>
                            {% if tx.paymentType == "VIREMENT BANCAIRE" %}
                                <span class="badge bg-label-success text-dark me-1">{{tx.bank}}</span>
                                <span class="badge bg-label-success text-dark me-1">{{tx.idCard|number_format('0','-','-')}}</span>
                                <span class="badge bg-label-success text-dark me-1">{{tx.bankCountry}}</span>
                            {% elseif tx.paymentType == "CRYPTO-MONNAIE" %}
                                <span class="badge bg-label-success text-dark me-1">{{tx.cryptoName}}</span>
                                <span class="badge bg-label-success text-dark me-1">{{tx.walletAddress}}</span>
                            {% elseif tx.paymentType == "MOBILE MONEY" %}
                                <span class="badge bg-label-success text-dark me-1">{{tx.momoOperator}}</span>
                                <span class="badge bg-label-success text-dark me-1">{{tx.phone}}</span>
                            {% endif %}
                          </td>
                          <td>
                            {% if tx.status == "en attente de traitement" %}
                               <span class="badge bg-label-warning text-dark me-1">{{tx.status|upper}}</span>
                            {% elseif tx.status == "annulée" %}
                                <span class="badge bg-label-danger text-dark me-1">{{tx.status|upper}}</span>
                            {% elseif tx.status == "acceptée" %}
                                <span class="badge bg-label-success text-dark me-1">{{tx.status|upper}}</span>
                            {% endif %}
                          </td>
                          <td>
                            {% if tx.status == "en attente de traitement" %}
                                <a href="{{path('admins.rechargements.withdrawal.status',{id: tx.id, reference: tx.reference, status: "accepted"})}}" class="btn btn-sm btn-success text-dark"><strong>VALIDER LA DEMANDE RETRAIT</strong></a>
                                <a href="{{path('admins.rechargements.withdrawal.status',{id: tx.id, reference: tx.reference, status: "canceled"})}}" class="btn btn-sm btn-outline-danger text-dark"><strong>ANNULER LA DEMANDE RETRAIT</strong></a>
                            {% elseif tx.status == "annulée" %}
                                <a href="{{path('admins.rechargements.withdrawal.status',{id: tx.id, reference: tx.reference, status: "accepted"})}}" class="btn btn-sm btn-success text-dark"><strong>VALIDER LA DEMANDE RETRAIT</strong></a>
                            {% elseif tx.status == "acceptée" %}
                                <a href="{{path('admins.rechargements.withdrawal.status',{id: tx.id, reference: tx.reference, status: "canceled"})}}" class="btn btn-sm btn-outline-danger text-dark"><strong>ANNULER LA DEMANDE RETRAIT</strong></a>
                            {% endif %}
                        </td>
                        </tr>
                      {% endfor %}

                      {% if txs | length == 0 %}
                        <tr class="table-dark">
                          <td colspan="7">
                            <p class="text-center text-muted">Aucune demande de retrait disponible</p>
                          </td>
                        </tr>
                      {% endif %}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- / Content -->

      <div class="content-backdrop fade"></div>
    </div>
    <!-- Content wrapper -->

    <script src="{{asset('admins/js/withdrawal/hideOrShow.js')}}"></script>
  {% endblock body %}
