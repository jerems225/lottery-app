{% extends './admins/adminbase.html.twig' %}
{% block title %}Demandes de retraits
{% endblock title %}
{% block body %}
	<!-- Content wrapper -->
	<div
		class="content-wrapper">
		<!-- Content -->

		<div class="container-xxl flex-grow-1 container-p-y">


			{% for message in app.flashes('withdrawals') %}
				<div class="alert alert-success text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			{% for message in app.flashes('admins.reject.withdrawal') %}
				<div class="alert alert-danger text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			{% for message in app.flashes('admins.valid.withdrawal') %}
				<div class="alert alert-success text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			{% for message in app.flashes('withdrawals.values.error') %}
				<div class="alert alert-danger text-dark" align="center">
					<b>{{message}}</b>
				</div>
			{% endfor %}

			<div class="col-xl-12">
				<div class="card">
					<div class="card-header border-bottom d-flex align-items-center justify-content-between">
						<h5 class="m-0 text-uppercase fw-bold">Demandes de Retraits</h5>
						<span class="badge bg-label-primary">{{app.user.withdrawals|length}}
							Total</span>
					</div>
					<div class="card-body pt-4">
						<div class="table-responsive text-nowrap">
							<table class="table table-hover">
								<thead>
									<tr>
										<th>TEMPS</th>
										<th>TRANS. ID</th>
										<th>MONTANT</th>
										<th>INFOS PAIEMENT</th>
										<th>STATUT</th>
										<th class="text-center">ACTIONS</th>
									</tr>
								</thead>
								<tbody class="table-border-bottom-0">
									{% for tx in txs | reverse %}
										<tr>
											<td>
												<span class="text-muted small d-block">{{tx.createdAt|format_datetime('medium', 'none', locale='fr')}}</span>
												<span class="fw-bold small">{{tx.createdAt|format_datetime('none', 'short', locale='fr')}}</span>
											</td>
											<td>
												<code class="text-dark small">{{tx.reference|slice(0, 10)}}...</code>
											</td>
											<td>
												<span class="badge bg-label-success fw-bold">{{tx.amount|number_format(2)}}
													$</span>
											</td>
											<td>
												<div class="d-flex flex-column gap-1">
													<span class="badge bg-label-info w-fit" style="width: fit-content;">{{tx.paymentType}}</span>
													<div class="small">
														{% if tx.paymentType == "VIREMENT BANCAIRE" %}
															<div class="text-muted">
																<i class="bx bx-bank"></i>
																{{tx.bank}}
																({{tx.bankCountry}})</div>
															<div class="text-dark fw-bold">ID:
																{{tx.idCard}}</div>
														{% elseif tx.paymentType == "CRYPTO-MONNAIE" %}
															<div class="text-muted">
																<i class="bx bx-bitcoin"></i>
																{{tx.cryptoName}}</div>
															<code class="text-primary small">{{tx.walletAddress}}</code>
														{% elseif tx.paymentType == "MOBILE MONEY" %}
															<div class="text-muted">
																<i class="bx bx-phone-call"></i>
																{{tx.momoOperator}}</div>
															<span class="fw-bold">{{tx.phone}}</span>
														{% endif %}
													</div>
												</div>
											</td>
											<td>
												{% if tx.status == "en attente de traitement" %}
													<span class="badge bg-label-warning">À traiter</span>
												{% elseif tx.status == "annulée" %}
													<span class="badge bg-label-danger">Annulée</span>
												{% elseif tx.status == "acceptée" %}
													<span class="badge bg-label-success">Acceptée</span>
												{% endif %}
											</td>
											<td class="text-center">
												<div class="d-flex justify-content-center gap-2">
													{% if tx.status != "acceptée" %}
														<a href="{{path('admins.rechargements.withdrawal.status',{id: tx.id, reference: tx.reference, status: "accepted"})}}" class="btn btn-icon btn-sm btn-label-success" title="Valider">
															<i class="bx bx-check"></i>
														</a>
													{% endif %}
													{% if tx.status != "annulée" %}
														<a href="{{path('admins.rechargements.withdrawal.status',{id: tx.id, reference: tx.reference, status: "canceled"})}}" class="btn btn-icon btn-sm btn-label-danger" title="Annuler">
															<i class="bx bx-x"></i>
														</a>
													{% endif %}
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

			{% if txs | length == 0 %}
				<tr class="table-dark">
					<td colspan="7">
						<p class="text-center text-muted">Aucune demande de retrait disponible</p>
					</td>
				</tr>
			{% endif %}
		</tbody>
	</table>
</div></div></div></div></div></div><!-- / Content --><div class="content-backdrop fade"></div></div><!-- Content wrapper --><script src="{{asset('admins/js/withdrawal/hideOrShow.js')}}"></script>{% endblock body %}
