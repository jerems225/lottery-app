<!DOCTYPE html>
<html lang="fr">

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}{% endblock %}
			| BitLOT</title>
		<link rel="icon" type="image/x-icon" href="{{asset('assets/img/cr_fav.png')}}"/>
		<link rel="stylesheet" href="{{asset('lottery-assets/css/style.css')}}">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
		<style>
			.auth-container {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 60px 20px;
				background: radial-gradient(circle at 50% 50%, rgba(255, 204, 0, 0.05) 0%, transparent 70%);
			}

			.auth-card {
				background: var(--bg-card);
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
				border-radius: 32px;
				padding: 48px;
				width: 100%;
				max-width: 500px;
				box-shadow: var(--shadow-lg), var(--glass-glow);
				text-align: center;
				border: 1px solid var(--glass-border);
			}

			.auth-header h2 {
				font-size: 2rem;
				font-weight: 900;
				margin-bottom: 12px;
				color: #fff;
				letter-spacing: -1px;
			}

			.auth-header p {
				color: var(--text-muted);
				margin-bottom: 40px;
				font-size: 1rem;
			}

			.auth-form-group {
				text-align: left;
				margin-bottom: 24px;
			}

			.auth-form-group label {
				display: block;
				margin-bottom: 10px;
				font-weight: 600;
				font-size: 0.9rem;
				color: var(--text-light);
			}

			.auth-form-group input,
			.auth-input {
				width: 100%;
				padding: 16px;
				border-radius: 12px;
				border: 1px solid var(--glass-border);
				background: rgba(255, 255, 255, 0.03);
				color: #fff;
				font-family: inherit;
				transition: var(--transition);
				outline: none;
				font-size: 1rem;
			}

			.auth-form-group input:focus,
			.auth-input:focus {
				border-color: var(--primary-gold);
				box-shadow: 0 0 15px rgba(255, 204, 0, 0.2);
				background: rgba(255, 255, 255, 0.05);
			}

			.forgot-link {
				display: block;
				text-align: right;
				font-size: 0.85rem;
				color: var(--primary-gold);
				text-decoration: none;
				font-weight: 600;
				margin-top: 10px;
				transition: var(--transition);
			}

			.forgot-link:hover {
				text-shadow: var(--glow-gold);
			}

			.auth-btn {
				width: 100%;
				padding: 18px;
				background: linear-gradient(135deg, var(--primary-gold), var(--secondary-gold));
				color: var(--bg-deep);
				border: none;
				border-radius: 16px;
				font-weight: 800;
				font-size: 1.1rem;
				text-transform: uppercase;
				letter-spacing: 1px;
				cursor: pointer;
				transition: var(--transition);
				margin-top: 32px;
				box-shadow: var(--glow-gold);
			}

			.auth-btn:hover {
				transform: translateY(-3px);
				box-shadow: var(--glow-gold-strong);
				filter: brightness(1.1);
			}

			.social-auth {
				margin-top: 40px;
				padding-top: 32px;
				border-top: 1px solid var(--glass-border);
			}

			.social-btns {
				display: flex;
				gap: 16px;
				margin-top: 24px;
			}

			.social-btn {
				flex: 1;
				padding: 14px;
				border-radius: 12px;
				border: 1px solid var(--glass-border);
				background: rgba(255, 255, 255, 0.03);
				cursor: pointer;
				transition: var(--transition);
				display: flex;
				align-items: center;
				justify-content: center;
				color: #fff;
				font-size: 20px;
			}

			.social-btn:hover {
				border-color: var(--primary-gold);
				background: rgba(255, 255, 255, 0.08);
				transform: translateY(-3px);
				box-shadow: var(--glow-gold);
			}

			.footer-text {
				margin-top: 40px;
				font-size: 0.95rem;
				color: var(--text-muted);
			}

			.footer-text a {
				color: var(--primary-gold);
				font-weight: 700;
				text-decoration: none;
				transition: var(--transition);
			}

			.footer-text a:hover {
				text-shadow: var(--glow-gold);
			}

			.auth-error {
				background: rgba(220, 38, 38, 0.1);
				color: #ff4d4d;
				padding: 16px;
				border-radius: 12px;
				font-size: 0.9rem;
				font-weight: 600;
				margin-bottom: 24px;
				border: 1px solid rgba(220, 38, 38, 0.2);
			}

			.success-msg {
				display: none;
				background: #E8F5E9;
				color: #2E7D32;
				padding: 24px;
				border-radius: var(--radius-md);
				margin-top: 24px;
				font-weight: 600;
				border: 1px solid #C8E6C9;
			}

			.back-link {
				display: inline-block;
				margin-top: 32px;
				font-size: 14px;
				color: var(--text-muted);
				text-decoration: none;
				font-weight: 600;
				transition: var(--transition);
			}

			.back-link:hover {
				color: var(--text-main);
			}

			@media(max-width: 480px) {
				.auth-card {
					padding: 32px 24px;
					border-radius: 20px;
				}

				.auth-header h2 {
					font-size: 24px;
				}
			}
		</style>
	</head>

	{% block body %}{% endblock %}

</html>
