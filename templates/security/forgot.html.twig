{% extends './security/loginbase.html.twig' %}
{% block title %}
  Reinitialisation du Mot de passe 
{% endblock %}
{% block body %}
  <body>

    <div class="limiter">
      <div class="container-login100" style="background-image: url('{{asset('assets/img/banner-3.jpg')}}'); background-size:cover;">
        <div class="wrap-login100">
          <form class="login100-form validate-form p-l-55 p-r-55 p-t-178" method="post">
            <span class="login100-form-title">
              CRYPTOBET - VERIFICATION D'EMAIL
            </span>

            <div class="wrap-input100 validate-input m-b-16 m-t-14">
              {{form_widget(form.email, {'attr':{'class':'input100','placeholder':'Votre email svp ...'}})}}
              <span class="focus-input100"></span>
            </div>

            <small class="mt-4 mb-4">
                {% for message in app.flashes('email.error') %}
                  <p style="color:red;"><b>{{message}}</b></p>
                  
                <br />
                {% endfor %}
            </small>

            <small class="mt-4 mb-4">
              {% for message in app.flashes('reset.error') %}
                <p style="color:red;"><b>{{message}}</b></p>
                
                <br />
              {% endfor %}
           </small>

            <small class="mt-4 mb-4">
              {% for message in app.flashes('verify.error') %}
                <p style="color:red;"><b>{{message}}</b></p>
                
                <br />
              {% endfor %}
           </small>

            <small class="mt-4 mb-4">
                {% for message in app.flashes('email.send') %}
                  <p class="text-success"><b>{{message}}</b></p>
                {% endfor %}

                <br />
            </small>


			{{form_widget(form._token)}}

            <div class="container-login100-form-btn">
              <button class="login100-form-btn">
                VERIFICATION
              </button>
            </div>

            <div class="flex-col-c p-t-170 p-b-40">
              <span class="txt1 p-b-9">
                Vous avez un compte?
              </span>

              <a href="{{path('app_login')}}" class="txt3">
                Connectez vous maintenant
              </a>

			  <span class="txt1 p-b-9">
				<a href="{{path('index')}}">Retour sur l'acceuil <i class="fa fa-home"></i></a>
			  </span>
            </div>
          </form>
        </div>
      </div>
    </div>
  {% endblock %}
