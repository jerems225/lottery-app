{% extends './security/loginbase.html.twig' %}
{% block title %}Mot de passe oublié
{% endblock %}
{% block body %}
	<body>
		<div class="auth-container">
			<div class="auth-card">
				<div class="auth-header">
					<i class="fas fa-lock lock-icon"></i>
					<h2>Reset Password</h2>
					<p>Enter your email and we'll send you instructions to reset your password.</p>
				</div>

				<form id="reset-form" method="post">
					<div class="auth-form-group">
						<label>Email Address</label>
						<input type="email" name="email" placeholder="name@example.com" required>
					</div>

					<button type="submit" class="auth-btn">Reset Password</button>
				</form>

				{% for message in app.flashes('success') %}
					<div style="background: #E8F5E9; color: #2E7D32; padding: 24px; border-radius: 16px; margin-top: 24px; font-weight: 600; border: 1px solid #C8E6C9;">
						<i class="fas fa-check-circle"></i><br>
						{{ message }}
					</div>
				{% endfor %}

				<a href="{{path('app_login')}}" class="back-link">
					<i class="fas fa-arrow-left"></i>
					Back to login</a>
			</div>
		</div>
	</body>
{% endblock %}
