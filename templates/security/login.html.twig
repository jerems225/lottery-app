{% extends './security/loginbase.html.twig' %}
{% block title %}
  Connexion
{% endblock %}
{% block body %}
  <body>

    <div class="limiter">
      <div class="container-login100" style="background-image: url('{{asset('assets/img/banner-3.jpg')}}'); background-size:cover;">
        <div class="wrap-login100">
          <form class="login100-form validate-form p-l-55 p-r-55 p-t-178" method="post">
            <span class="login100-form-title">
              CONNEXION - CRYPTOBET
            </span>

            <div class="wrap-input100 validate-input m-b-16" data-validate="example@mail.com">
              <input class="input100" type="email" name="email" value="{{ last_username }}" required="required" autofocus="autofocus" placeholder="Email">
              <span class="focus-input100"></span>
            </div>

            <div class="wrap-input100 validate-input" data-validate="Mot de passe requis">
              <input class="input100" type="password" name="password" autocomplete="current-password" required="required" placeholder="Mot de passe">
              <span class="focus-input100"></span>
            </div>

            <input class="input-checkbox100" id="ckb1" type="hidden" name="_remember_me" checked="checked">

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="text-right p-t-13 p-b-23">
              <span class="txt1">
                Vous avez oublié
              </span>

              <a href="{{path('forget.password')}}" class="txt2">
                votre mot de passe
              </a>
            </div>

            <div class="container-login100-form-btn">
              <button class="login100-form-btn">
                Connexion
              </button>
            </div>

            <div class="mt-4">
              {% if error %}
                <p class="text-center bg-danger text-white p-3">Votre Email ou mot de passe est incorrect!</p>
                {%endif%}
              </div>

              <div class="flex-col-c p-t-170 p-b-40">
                <span class="txt1 p-b-9">
                  Vous n'avez pas de compte?
                </span>

                <a href="{{path('app_register')}}" class="txt3">
                  Inscrivez vous maintenant
                </a>

                <span class="txt1 p-b-9">
                  <a href="{{path('index')}}">Retour sur l'acceuil <i class="fa fa-home"></i></a>
                </span>
              </div>
            </form>
          </div>
        </div>
    </div>
{% endblock %}
