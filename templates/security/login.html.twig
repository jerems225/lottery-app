{% extends './security/loginbase.html.twig' %}
{% block title %}Connexion
{% endblock %}
{% block body %}
	<body>
		<div class="auth-container">
			<div class="auth-card">
				<div class="auth-header">
					<a href="{{path('index')}}">
						<div class="logo-text" style="display:inline-block;">
							<span class="brand-name" style="font-size:32px;">BitLOT</span>
						</div>
					</a>
					<h2>Welcome back</h2>
					<p>Login to your BitLOT account</p>
				</div>

				{# Flash messages #}
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="auth-{{ label == 'success' ? 'success' : 'error' }}" style="{{ label == 'success' ? 'background:#E8F5E9; color:#2E7D32; border-color:#C8E6C9;' : '' }}">
							<i class="fas fa-{{ label == 'success' ? 'check-circle' : 'exclamation-circle' }}"></i>
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}

				{% if error %}
					<div class="auth-error">
						<i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
						{{ error.messageKey|trans(error.messageData, 'security') }}
					</div>
				{% endif %}

				<form method="post">
					<div class="auth-form-group">
						<label>Email Address</label>
						<input type="email" name="email" value="{{ last_username }}" required autofocus placeholder="name@example.com">
					</div>
					<div class="auth-form-group">
						<label>Password</label>
						<input type="password" name="password" autocomplete="current-password" required placeholder="••••••••">
						<a href="{{path('forget.password')}}" class="forgot-link">Forgot password?</a>
					</div>

					<input type="hidden" name="_remember_me" value="1">
					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<button type="submit" class="auth-btn">Sign In</button>
				</form>

				<div class="social-auth">
					<span style="font-size: 13px; color: var(--text-muted);">Or continue with</span>
					<div class="social-btns">
						<button class="social-btn">
							<i class="fab fa-google"></i>
						</button>
						<button class="social-btn">
							<i class="fab fa-apple"></i>
						</button>
					</div>
				</div>

				<div class="footer-text">
					Don't have an account?
					<a href="{{path('app_register')}}">Create one</a>
				</div>

				<div class="footer-text" style="margin-top: 12px;">
					<a href="{{path('index')}}" style="color: var(--text-muted);">
						<i class="fas fa-arrow-left"></i>
						Back to home</a>
				</div>
			</div>
		</div>
	</body>
{% endblock %}
