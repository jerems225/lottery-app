{% extends './security/loginbase.html.twig' %}
{% block title %}
	Réinitialisation du mot de passe
{% endblock %}
{% block body %}
	<body>
		<div class="auth-container">
			<div class="auth-card">
				<div class="auth-header">
					<i class="fas fa-shield-alt lock-icon"></i>
					<h2>New Password</h2>
					<p>Choose a strong password to secure your account.</p>
				</div>

				{{ form_start(form, {'attr': {'method': 'post', 'id': 'reset-password-form'}}) }}

				<div class="auth-form-group">
					<label>New Password</label>
					{{ form_widget(form.password, {'attr': {'placeholder': 'Enter a new password...', 'id': 'reset_pass_word_password', 'style': 'width:100%;padding:16px;border-radius:8px;border:1px solid #E2E8F0;background:#F8FAFC;font-family:inherit;outline:none;font-size:15px;'}}) }}
				</div>
				<div class="auth-form-group">
					<label>Confirm Password</label>
					<input type="password" id="confirm_pass" name="password_confirm" required placeholder="Confirm password" style="width:100%;padding:16px;border-radius:8px;border:1px solid #E2E8F0;background:#F8FAFC;font-family:inherit;outline:none;font-size:15px;">
				</div>

				<div id="correct" style="display:none;background:#E8F5E9;color:#2E7D32;padding:12px;border-radius:12px;font-weight:600;border:1px solid #C8E6C9;margin-bottom:16px;text-align:center;">
					<i class="fas fa-check-circle"></i>
					Passwords match!
				</div>
				<div id="incorrect" style="display:none;background:#FEE2E2;color:#DC2626;padding:12px;border-radius:12px;font-weight:600;border:1px solid #FECACA;margin-bottom:16px;text-align:center;">
					<i class="fas fa-times-circle"></i>
					Passwords don't match!
				</div>

				{{ form_widget(form._token) }}

				<button type="submit" class="auth-btn" style="margin-top: 10px;">Reset Password</button>
				{{ form_end(form) }}

				<div class="footer-text">
					Remember your password?
					<a href="{{path('app_login')}}">Sign In</a>
				</div>

				<div class="footer-text" style="margin-top: 12px;">
					<a href="{{path('index')}}" style="color: var(--text-muted);">
						<i class="fas fa-arrow-left"></i>
						Back to home</a>
				</div>
			</div>
		</div>

		<script>
			var new_pass = document.getElementById('reset_pass_word_password');
var confirm_pass = document.getElementById('confirm_pass');
var correct = document.getElementById('correct');
var incorrect = document.getElementById('incorrect');

function checkPasswords() {
if (confirm_pass.value === "" && new_pass.value === "") {
correct.style.display = 'none';
incorrect.style.display = 'none';
return;
}

if (confirm_pass.value !== "" && new_pass.value !== "") {
if (confirm_pass.value === new_pass.value) {
correct.style.display = 'block';
incorrect.style.display = 'none';
} else {
correct.style.display = 'none';
incorrect.style.display = 'block';
}
}
}

if (confirm_pass) 
confirm_pass.oninput = checkPasswords;

if (new_pass) 
new_pass.oninput = checkPasswords;
		</script>
	</body>
{% endblock %}
