{% extends './security/loginbase.html.twig' %}
{% block title %}
  Reinitialisation du Mot de passe 
{% endblock %}
{% block body %}
  <body>

    <div class="limiter">
      <div class="container-login100" style="background-image: url('{{asset('assets/img/banner-3.jpg')}}'); background-size:cover;">
        <div class="wrap-login100">
          <form class="login100-form validate-form p-l-55 p-r-55 p-t-178" method="post">
            <span class="login100-form-title">
              CRYPTOBET - REINITIALISER LE MOT DE PASSE
            </span>

            <div class="wrap-input100 validate-input m-b-16 m-t-35">
              {{form_widget(form.password, {'attr':{'class':'input100','placeholder':'Entrer un nouveau mot de passe ...'}})}}
              <span class="focus-input100"></span>
            </div>
            <div class="wrap-input100 validate-input m-b-16 m-t-14" data-validate="Mot de passe requis">
                <input class="input100" type="password" id="confirm_pass" name="password" autocomplete="current-password" required="required" placeholder="Confirmer le mot de passe">
                <span class="focus-input100"></span>
            </div>

            <small class="text-center">
              <p class="text-success alert alert-success" id="correct"><b>Mot de passe correct !!</b></p>
              <p class="text-danger alert alert-danger" id="incorrect"><b>Mot de passe incorrect !!</b></p>
            </small>


			{{form_widget(form._token)}}

            <div class="container-login100-form-btn">
              <button class="login100-form-btn">
                REINITIALISER
              </button>
            </div>

            <div class="flex-col-c p-t-170 p-b-40">
              <span class="txt1 p-b-9">
                Vous avez un compte?
              </span>

              <a href="{{path('app_login')}}" class="txt3">
                Connectez vous maintenant
              </a>

			  <span class="txt1 p-b-9">
				<a href="{{path('index')}}">Retour sur l'acceuil <i class="fa fa-home"></i></a>
			  </span>
            </div>
          </form>
        </div>
      </div>
    </div>


    <script>
      var new_pass = document.getElementById('reset_pass_word_password');
      var confirm_pass = document.getElementById('confirm_pass');

      var correct = document.getElementById('correct');
      var incorrect = document.getElementById('incorrect');

      window.addEventListener('load', () => {
        correct.style.display = 'none'
        incorrect.style.display = 'none'
      })

      confirm_pass.oninput = function() {
            if((confirm_pass.value != "" && new_pass.value != "") && confirm_pass.value == new_pass.value)
            {
              correct.style.display = 'block'
              incorrect.style.display = 'none'
            }
            else if((confirm_pass.value != "" && new_pass.value != "") && confirm_pass.value != new_pass.value)
            {
              incorrect.style.display = 'block'
              correct.style.display = 'none'
            }
            
            if(confirm_pass.value == "" && new_pass == "")
            {
              correct.style.display = 'none'
              incorrect.style.display = 'none'
            }
        }

        new_pass.oninput = function() {
          if((confirm_pass.value != "" && new_pass.value != "") && confirm_pass.value == new_pass.value)
          {
            correct.style.display = 'block'
            incorrect.style.display = 'none'
          }
          else if((confirm_pass.value != "" && new_pass.value != "") && confirm_pass.value != new_pass.value)
          {
            correct.style.display = 'none'
            incorrect.style.display = 'block'
          }
          
          if(confirm_pass.value == "" && new_pass == "")
          {
            correct.style.display = 'none'
            incorrect.style.display = 'none'
          }
        }
    </script>
  {% endblock %}
