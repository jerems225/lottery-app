{% extends './security/loginbase.html.twig' %}
{% block title %}Inscription
{% endblock %}
{% block body %}
	<body>
		<div class="auth-container">
			<div class="auth-card">
				<div class="auth-header">
					<a href="{{path('index')}}">
						<div class="logo-text" style="display:inline-block;">
							<span class="brand-name" style="font-size:32px;">BitLOT</span>
						</div>
					</a>
					<h2>Create Account</h2>
					<p>Join BitLOT and start winning today</p>
				</div>

				{# Flash messages #}
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="auth-{{ label == 'success' ? 'success' : 'error' }}" style="{{ label == 'success' ? 'background:#E8F5E9; color:#2E7D32; border-color:#C8E6C9;' : '' }}">
							<i class="fas fa-{{ label == 'success' ? 'check-circle' : 'exclamation-circle' }}"></i>
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}

				{% set referrer = referrer|default('') %}
				{{ form_start(form, {'attr': {'method': 'post'}}) }}

				{% if not form.vars.valid %}
					<div class="auth-error">
						<i class="fas fa-exclamation-circle"></i>
						Please correct the errors in the form below.
					</div>
				{% endif %}

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
					<div class="auth-form-group">
						<label>Username</label>
						{{ form_widget(form.pseudo, {'attr': {'placeholder': 'johndoe77', 'class': 'auth-input'}}) }}
						{{ form_errors(form.pseudo) }}
					</div>
					<div class="auth-form-group">
						<label>Phone</label>
						{{ form_widget(form.phone, {'attr': {'placeholder': '+33 6 XX XX XX', 'class': 'auth-input'}}) }}
						{{ form_errors(form.phone) }}
					</div>
				</div>
				<div class="auth-form-group">
					<label>Email Address</label>
					{{ form_widget(form.email, {'attr': {'placeholder': 'name@example.com', 'class': 'auth-input'}}) }}
					{{ form_errors(form.email) }}
				</div>
				<div class="auth-form-group">
					<label>Password</label>
					{{ form_widget(form.password, {'attr': {'placeholder': 'Min. 8 characters', 'class': 'auth-input'}}) }}
					{{ form_errors(form.password) }}
				</div>
				<div class="auth-form-group">
					<label>Referral Code
						<span style="color: var(--text-muted); font-weight: 400;">(Optional)</span>
					</label>
					{{ form_widget(form.referrer, {'attr': {'placeholder': 'Referral code', 'value': referrer, 'class': 'auth-input'}}) }}
					{{ form_errors(form.referrer) }}
				</div>

				{{ form_widget(form._token) }}

				<button type="submit" class="auth-btn" style="margin-top: 10px;">Get Started</button>
				{{ form_end(form) }}

				<div class="footer-text">
					Already have an account?
					<a href="{{path('app_login')}}">Sign In</a>
				</div>

				<div class="footer-text" style="margin-top: 12px;">
					<a href="{{path('index')}}" style="color: var(--text-muted);">
						<i class="fas fa-arrow-left"></i>
						Back to home</a>
				</div>
			</div>
		</div>
	</body>
{% endblock %}
