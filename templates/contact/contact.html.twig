{% extends 'base.html.twig' %}
{% block title %}Contact |
{% endblock title %}

{% block stylesheets %}
	<style>
		.contact-grid {
			display: grid;
			grid-template-columns: 1fr 1.5fr;
			gap: 48px;
			padding: 60px 0;
		}

		@media(max-width: 900px) {
			.contact-grid {
				grid-template-columns: 1fr;
			}
		}

		.contact-info-card {
			background: #111827;
			color: white;
			border-radius: 32px;
			padding: 48px;
			position: relative;
			overflow: hidden;
		}

		.contact-info-card h3 {
			font-size: 24px;
			margin-bottom: 32px;
			color: var(--primary-gold);
		}

		.info-item {
			display: flex;
			align-items: center;
			gap: 20px;
			margin-bottom: 32px;
		}

		.info-item i {
			width: 48px;
			height: 48px;
			background: rgba(212, 175, 55, 0.1);
			color: var(--primary-gold);
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 12px;
			font-size: 20px;
		}

		.contact-form-card {
			background: white;
			border-radius: 32px;
			padding: 48px;
			box-shadow: var(--shadow-xl);
			border: 1px solid rgba(0, 0, 0, 0.03);
		}

		.contact-form-group {
			margin-bottom: 24px;
		}

		.contact-form-group label {
			display: block;
			margin-bottom: 8px;
			font-weight: 600;
			color: #374151;
			font-size: 14px;
		}

		.contact-form-group input,
		.contact-form-group textarea,
		.contact-form-group select {
			width: 100%;
			padding: 16px;
			border-radius: 12px;
			border: 1px solid #E2E8F0;
			background: #F8FAFC;
			transition: var(--transition);
			font-family: inherit;
			outline: none;
		}

		.contact-form-group input:focus,
		.contact-form-group textarea:focus,
		.contact-form-group select:focus {
			border-color: var(--primary-gold);
			background: white;
			box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.1);
		}

		.submit-btn {
			width: 100%;
			background: var(--primary-gold);
			color: white;
			border: none;
			padding: 18px;
			border-radius: 16px;
			font-weight: 800;
			cursor: pointer;
			transition: var(--transition);
			font-size: 16px;
		}

		.submit-btn:hover {
			background: var(--dark-gold);
			transform: translateY(-2px);
		}

		@media(max-width: 640px) {
			.contact-info-card,
			.contact-form-card {
				padding: 32px 24px;
				border-radius: 24px;
			}

			.contact-info-card h3 {
				font-size: 20px;
			}
		}
	</style>
{% endblock %}

{% block body %}
	<main class="container">
		{% for message in app.flashes('contact') %}
			<div style="background: #E8F5E9; color: #2E7D32; padding: 16px 24px; border-radius: 12px; margin-top: 20px; font-weight: 600; border: 1px solid #C8E6C9;">
				<i class="fas fa-check-circle"></i>
				{{ message }}
			</div>
		{% endfor %}

		<div class="contact-grid">
			<div class="contact-info-card">
				<h3>Contact Information</h3>
				<p style="color: #94A3B8; margin-bottom: 40px;">Have questions? Our team is here to help you 24/7. Reach out via any of these channels.</p>
				<div class="info-item">
					<i class="fas fa-envelope"></i>
					<div>
						<span style="display:block; font-size: 12px; color: #94A3B8;">Email</span>
						<strong>support@bitlot.com</strong>
					</div>
				</div>
				<div class="info-item">
					<i class="fab fa-telegram-plane"></i>
					<div>
						<span style="display:block; font-size: 12px; color: #94A3B8;">Telegram</span>
						<strong>@BitLOT_Official</strong>
					</div>
				</div>
				<div class="info-item">
					<i class="fas fa-map-marker-alt"></i>
					<div>
						<span style="display:block; font-size: 12px; color: #94A3B8;">Headquarters</span>
						<strong>Dubai, Crypto Valley, UAE</strong>
					</div>
				</div>

				<div style="margin-top: 60px; display: flex; gap: 16px;">
					<a href="#" style="color:white; font-size: 20px;">
						<i class="fab fa-twitter"></i>
					</a>
					<a href="#" style="color:white; font-size: 20px;">
						<i class="fab fa-discord"></i>
					</a>
					<a href="#" style="color:white; font-size: 20px;">
						<i class="fab fa-medium"></i>
					</a>
				</div>
			</div>

			<div class="contact-form-card">
				{{ form_start(form, {'attr': {'id': 'contact-form'}}) }}
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
					<div class="contact-form-group">
						<label>Full Name</label>
						{{ form_widget(form.fullname, {'attr': {'class': '', 'placeholder': 'John Doe', 'style': 'width:100%;padding:16px;border-radius:12px;border:1px solid #E2E8F0;background:#F8FAFC;font-family:inherit;outline:none;'}}) }}
					</div>
					<div class="contact-form-group">
						<label>Email Address</label>
						{{ form_widget(form.email, {'attr': {'class': '', 'placeholder': 'john@example.com', 'style': 'width:100%;padding:16px;border-radius:12px;border:1px solid #E2E8F0;background:#F8FAFC;font-family:inherit;outline:none;'}}) }}
					</div>
				</div>
				<div class="contact-form-group">
					<label>Subject</label>
					{{ form_widget(form.subject, {'attr': {'class': '', 'placeholder': 'Subject', 'style': 'width:100%;padding:16px;border-radius:12px;border:1px solid #E2E8F0;background:#F8FAFC;font-family:inherit;outline:none;'}}) }}
				</div>
				<div class="contact-form-group">
					<label>Message</label>
					{{ form_widget(form.message, {'attr': {'class': '', 'placeholder': 'Write your message here...', 'rows': '5', 'style': 'width:100%;padding:16px;border-radius:12px;border:1px solid #E2E8F0;background:#F8FAFC;font-family:inherit;outline:none;resize:vertical;'}}) }}
				</div>
				<button type="submit" class="submit-btn">Send Message</button>
				{{ form_end(form) }}
			</div>
		</div>
	</main>
{% endblock body %}
