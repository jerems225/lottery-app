{% extends 'base.html.twig' %}
{% block title %}Rooms |
{% endblock title %}
{% block body %}

	<main class="container">
		<section class="rooms-hero">
			<div class="glass-panel main-panel" style="background: white; border-radius: 40px; box-shadow: var(--shadow-xl); border: 1px solid rgba(0,0,0,0.03); padding: 60px;">
				<h1 style="font-weight: 900; letter-spacing: -0.04em;">Community Lottery Rooms</h1>
				<p style="color: var(--text-muted); font-size: 18px; max-width: 600px; margin: 16px auto;">Join our active lottery rooms or wait for special community draws to earn huge rewards.</p>
				<div class="action-bar" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 24px 40px; border-radius: 24px;">
					<div class="stats">
						<div class="stat-item">
							<span class="val" style="color: #111827; font-weight: 800;">{{ betrooms|length }}</span>
							<span class="lbl" style="font-weight: 700; font-size: 12px; color: #94A3B8;">Active Rooms</span>
						</div>
					</div>
					<button class="create-room-btn" id="open-create-room" style="background: linear-gradient(135deg, var(--primary-gold), var(--dark-gold)); padding: 18px 36px; border-radius: 16px; font-weight: 800; font-size: 15px; box-shadow: 0 10px 20px rgba(212, 175, 55, 0.2);">
						<i class="fas fa-plus-circle" style="margin-right: 8px;"></i>
						Join a Room
					</button>
				</div>
			</div>
		</section>

		<section class="rooms-list">
			<div class="filter-bar">
				<button class="filter-tab active">All Rooms</button>
				<button class="filter-tab" id="open-create-room-modal" style="background: var(--primary-gold); color: white; border-radius: 8px; margin-left: auto;">+ Create Private Room</button>
			</div>

			<div class="rooms-grid" id="rooms-container">
				{% for betroom in betrooms %}
					<div class="room-box {{ betroom.isPrivate ? 'private' : 'public' }}" style="{{ betroom.isPrivate ? 'border: 2px solid var(--primary-gold); background: linear-gradient(to bottom right, #fff, #FFFBEB);' : '' }}">
						<div class="room-header">
							<span class="room-id">
								{% if betroom.isPrivate %}
									<i class="fas fa-lock" style="color: var(--primary-gold); margin-right: 4px;"></i>
								{% endif %}
								#{{ betroom.numBetroom }}
							</span>
							<span class="status-badge" style="background: {% if betroom.status == 'sold out' or status == 'closed' %}#FEE2E2; color: #DC2626{% else %}#E8F5E9; color: #2E7D32{% endif %};">
								{{ (status == 'closed' ? 'CLOSED' : betroom.status)|upper }}
							</span>
						</div>
						<div class="room-body">
							<div class="creator-info">
								<img src="https://i.pravatar.cc/100?u={{ betroom.id }}" alt="Room" style="{{ betroom.isPrivate ? 'border-color: var(--primary-gold);' : '' }}">
								<div class="info-text">
									<span class="pseudo">{{ betroom.isPrivate ? (betroom.createdBy ? betroom.createdBy.pseudo : 'Private') : 'PUBLIC' }}</span>
									{% if betroom.isPrivate %}
										<span class="room-type" style="font-size: 10px; color: var(--primary-gold); font-weight: 700;">COMMUNITY ROOM</span>
									{% endif %}
								</div>
							</div>
							<div class="room-details">
								<div class="detail">
									<span class="lbl">Bet Amount</span>
									<span class="val gold">{{ betroom.ticketPrice|number_format(2) }}
										$</span>
								</div>
								<div class="detail">
									<span class="lbl">Participants</span>
									<span class="val">{{ betroom.buyTicket }}
										/
										{{ betroom.minParticipants ?: betroom.maxTicket }}</span>
								</div>
							</div>
							<div class="progress-container" style="background: #EDF2F7; height: 8px; border-radius: 4px;">
								<div class="progress-bar" style="width: {{ ((betroom.buyTicket / (betroom.minParticipants ?: betroom.maxTicket)) * 100)|round }}%; background: var(--primary-gold); height: 100%; border-radius: 4px;"></div>
							</div>
						</div>
						<div class="room-footer">
							{% if betroom.status == "sold out" or status == "closed" %}
								<button class="join-room-btn secondary" onclick="window.location.href='{{ path('betrooms.winner', {'reference': betroom.reference}) }}'">See Results</button>
							{% else %}
								<button class="join-room-btn" onclick="window.location.href='{{ path('betrooms.tickets', {'reference': betroom.reference}) }}'">Join Table</button>
							{% endif %}
						</div>
					</div>
				{% endfor %}
			</div>
		</section>
	</main>

	<!-- Create Room Modal -->
	<div id="create-room-modal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.5); backdrop-filter:blur(5px);">
		<div style="background:white; margin:10% auto; padding:32px; border-radius:24px; width:90%; max-width:500px; position:relative; box-shadow:var(--shadow-2xl);">
			<h2 style="margin-bottom:24px; font-weight:800;">Create Private Room</h2>
			<form action="{{ path('betrooms.create_private') }}" method="POST">
				<div style="margin-bottom:20px;">
					<label style="display:block; margin-bottom:8px; font-weight:600; color:#475569;">Bet Amount ($)</label>
					<input type="number" name="bet_amount" min="1" step="0.01" required style="width:100%; padding:12px; border:1px solid #E2E8F0; border-radius:12px;">
				</div>
				<div style="margin-bottom:24px;">
					<label style="display:block; margin-bottom:8px; font-weight:600; color:#475569;">Min Participants</label>
					<input type="number" name="min_participants" min="2" value="2" required style="width:100%; padding:12px; border:1px solid #E2E8F0; border-radius:12px;">
					<small style="color:#94A3B8;">Min 2 players required to trigger draw.</small>
				</div>
				<div style="display:flex; gap:12px;">
					<button type="button" id="close-modal" style="flex:1; padding:14px; border-radius:12px; border:1px solid #E2E8F0; font-weight:700;">Cancel</button>
					<button type="submit" style="flex:1; padding:14px; border-radius:12px; border:none; background:var(--primary-gold); color:white; font-weight:700;">Create Room</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		document.getElementById('open-create-room-modal').addEventListener('click', function () {
document.getElementById('create-room-modal').style.display = 'block';
});
document.getElementById('close-modal').addEventListener('click', function () {
document.getElementById('create-room-modal').style.display = 'none';
});
window.onclick = function (event) {
if (event.target == document.getElementById('create-room-modal')) {
document.getElementById('create-room-modal').style.display = 'none';
}
}
	</script>

{% endblock body %}
